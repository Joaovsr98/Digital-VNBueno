# Cabeçalhos de segurança no Cloudflare Pages (Security Baseline VN Bueno Digital 2027).
# Equivalente ao vercel.json. Mudou um? Mude nos dois enquanto a Vercel existir como reserva.
# HSTS entra aqui porque o Pages, com DNS fora da Cloudflare, não o adiciona sozinho (a Vercel adicionava).

/*
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# Arquivos estáticos não precisam das políticas de página.
/_astro/*
  ! Content-Security-Policy-Report-Only
  ! X-Frame-Options
  ! Permissions-Policy
  Cache-Control: public, max-age=31536000, immutable

/portfolio/*
  ! Content-Security-Policy-Report-Only
  ! X-Frame-Options
  ! Permissions-Policy

