---
// Página para oficinas mecânicas. Caso real: Garagem NotreDame (projeto em andamento, sem fechamento —
// ver CLAUDE.md §5; não chamar de cliente).
// Oferta para oficinas aprovada pelo fundador em 11/11/2026 — ver CLAUDE.md §8. Mudou? Atualizar `oferta` abaixo.
import Base from '../layouts/Base.astro';
import { linkWhatsApp } from '../data/site';

const mensagem = 'Olá! Vi a página para oficinas da VN Bueno Digital e quero um site para a minha oficina.';
const exemplo = 'https://garagemnotredame.vercel.app';

const recursos = [
  { titulo: 'Orçamento de cada serviço no WhatsApp', texto: 'O cliente toca em "Freio" ou "Suspensão" e a mensagem já chega pronta, dizendo o serviço que ele quer.' },
  { titulo: 'Fotos e vídeo reais da sua equipe', texto: 'Quem vê a oficina de verdade, com a equipe trabalhando, confia mais. As fotos abrem em tela cheia e deslizam para o lado.' },
  { titulo: '"Aberto agora" no topo do site', texto: 'O site mostra se a oficina está aberta naquele momento, pelo seu horário de funcionamento.' },
  { titulo: 'Como chegar e horários', texto: 'Mapa, rota no Google Maps e os horários da semana, para o cliente encontrar você sem precisar ligar.' },
  { titulo: 'Feito para o celular', texto: 'Quem procura mecânico normalmente está no celular, muitas vezes com o carro parado. O site foi pensado para essa tela.' },
  { titulo: 'Preparado para o Google', texto: 'O conteúdo é lido pelo Google, o que ajuda quem pesquisa "mecânica" na sua região a encontrar a sua oficina.' },
];

const caso = {
  nome: 'Garagem NotreDame',
  segmento: 'Oficina mecânica · Taboão da Serra, SP',
  imagem: '/portfolio/garagem-notredame.webp',
  url: exemplo,
  rotulo: 'Projeto em andamento',
  destaques: ['Orçamento por serviço no WhatsApp', 'Fotos e vídeo reais da equipe', 'Selo "aberto agora"', 'Mapa e horários'],
};

const oferta = {
  implantacao: 'R$ 500',
  servicosInclusos: 10,
  mensalidade: 'R$ 150',
  alteracoesMes: 2,
  aVista: 'R$ 1.200',
  avulsa: 'R$ 80',
};

const passos = [
  { titulo: 'Conversa rápida', texto: 'Você conta quais serviços faz, em que região atende e o horário da oficina.' },
  { titulo: 'Fotos e informações', texto: 'Você manda fotos e vídeos da oficina e da equipe. Pode ser do celular; a gente orienta como tirar.' },
  { titulo: 'Site no ar', texto: 'Montamos, você revisa e aprova, e o site vai para o ar com o seu WhatsApp e endereço.' },
];

const duvidas = [
  {
    p: 'Preciso de fotos profissionais?',
    r: 'Não. Fotos e vídeos feitos no celular, da sua equipe trabalhando de verdade, funcionam muito bem e passam mais confiança que banco de imagem.',
  },
  {
    p: 'O cliente consegue agendar pelo site?',
    r: 'O site leva o cliente direto para o seu WhatsApp, já dizendo qual serviço ele quer. Aí vocês combinam o horário na conversa, do jeito que você já atende hoje.',
  },
  {
    p: 'O que a mensalidade cobre?',
    r: `Manter o site no ar (hospedagem), o suporte pelo WhatsApp e até ${oferta.alteracoesMes} alterações por mês, como trocar preços, fotos e horários ou incluir um serviço. As alterações não acumulam para o mês seguinte. O detalhe fica no contrato.`,
  },
  {
    p: 'Posso pagar à vista, sem mensalidade?',
    r: `Sim: ${oferta.aVista} em pagamento único. Você tem 30 dias de ajustes depois da entrega e, depois disso, cada alteração custa ${oferta.avulsa}.`,
  },
  {
    p: `E se eu tiver mais de ${oferta.servicosInclusos} serviços?`,
    r: 'A gente conversa: dá para agrupar serviços parecidos ou incluir mais itens no orçamento da implantação.',
  },
  {
    p: 'Preciso ter domínio próprio (.com.br)?',
    r: 'Não é obrigatório para começar. Se quiser um endereço próprio, ajudamos a registrar; o domínio é pago à parte, direto no registro.br.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: duvidas.map((d) => ({ '@type': 'Question', name: d.p, acceptedAnswer: { '@type': 'Answer', text: d.r } })),
  },
];
---

<Base
  titulo="Site para oficina mecânica"
  descricao={`Site para oficina mecânica com orçamento de cada serviço direto no WhatsApp, fotos reais da equipe, horários e mapa. Implantação ${oferta.implantacao} e mensalidade ${oferta.mensalidade}.`}
  jsonLd={jsonLd}
>
  <!-- Topo -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[820px] -translate-x-1/2 rounded-full bg-violet-600/20 blur-3xl" aria-hidden="true"></div>

    <div class="container-site relative grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="eyebrow">Para oficinas mecânicas</p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.08] sm:text-5xl">
          Sua oficina encontrada no Google e o <span class="text-gradient">orçamento chegando no WhatsApp</span>.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
          Um site com os seus serviços, fotos reais da sua equipe e horários, para quem está com o carro parado escolher você e chamar na hora.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary !px-6 !py-3.5 text-base">Quero o site da minha oficina</a>
          <a href={exemplo} target="_blank" rel="noopener" class="btn-ghost !px-6 !py-3.5 text-base">
            Ver um exemplo <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-400">
          Implantação <strong class="text-white">{oferta.implantacao}</strong> · mensalidade <strong class="text-white">{oferta.mensalidade}</strong>
        </p>
      </div>

      <!-- Exemplo no celular -->
      <div class="mx-auto w-full max-w-[300px]">
        <div class="rounded-[2.2rem] border border-line bg-ink-900 p-2.5 shadow-2xl shadow-violet-900/30">
          <img
            src="/portfolio/garagem-notredame-celular.webp"
            alt="Site da Garagem NotreDame aberto no celular"
            width="390"
            height="844"
            class="w-full rounded-[1.7rem]"
          />
        </div>
        <p class="mt-3 text-center text-xs text-slate-400">Exemplo: Garagem NotreDame (projeto em andamento)</p>
      </div>
    </div>
  </section>

  <!-- O que o site tem -->
  <section class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">O que o site tem</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Tudo o que o motorista precisa para escolher sua oficina</h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {recursos.map((r) => (
          <article class="card p-6">
            <h3 class="text-lg font-semibold">{r.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{r.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Caso real -->
  <section id="exemplo" class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Exemplo real</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Garagem NotreDame, em Taboão da Serra</h2>
      <p class="mt-4 max-w-2xl text-slate-400">Oficina de verdade, com fotos e vídeo da própria equipe. Abra no celular e teste: toque num serviço e veja a mensagem chegar pronta.</p>
      <article class="card mt-12 grid overflow-hidden lg:grid-cols-[1.2fr_1fr]">
        <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-ink-800 lg:aspect-auto lg:border-b-0 lg:border-r">
          <img src={caso.imagem} alt={`Site ${caso.nome}`} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
          <span class="absolute bottom-3 left-3 rounded-full border border-white/10 bg-ink-950/80 px-3 py-1 text-xs text-slate-200 backdrop-blur">{caso.rotulo}</span>
        </div>
        <div class="flex flex-col p-6 sm:p-8">
          <p class="text-xs font-medium text-violet-300">{caso.segmento}</p>
          <h3 class="mt-1 text-2xl font-semibold">{caso.nome}</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {caso.destaques.map((d) => <li class="rounded-lg bg-ink-800 px-2.5 py-1 text-xs text-slate-300">{d}</li>)}
          </ul>
          <div class="mt-auto flex flex-wrap gap-3 pt-8">
            <a href={caso.url} target="_blank" rel="noopener" class="btn-ghost !px-4 !py-2.5">
              Ver o site <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
            </a>
            <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary !px-4 !py-2.5">Quero um assim</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Preço -->
  <section id="preco" class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Investimento</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Quanto custa</h2>

      <div class="mt-12 grid gap-5 lg:grid-cols-[1.3fr_1fr]">
        <article class="card border-violet-500/50 bg-gradient-to-b from-violet-600/10 to-transparent p-6 sm:p-8">
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <p class="text-sm text-slate-400">Implantação</p>
              <p class="mt-1 font-display text-4xl font-bold text-white">{oferta.implantacao}</p>
              <p class="mt-2 text-sm text-slate-300">pagamento único · até {oferta.servicosInclusos} serviços, galeria de fotos e vídeo, horários e mapa</p>
            </div>
            <div>
              <p class="text-sm text-slate-400">Mensalidade</p>
              <p class="mt-1 font-display text-4xl font-bold text-white">{oferta.mensalidade}<span class="text-lg font-semibold text-slate-400">/mês</span></p>
              <p class="mt-2 text-sm text-slate-300">site no ar, suporte pelo WhatsApp e {oferta.alteracoesMes} alterações por mês</p>
            </div>
          </div>
          <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary mt-8 w-full sm:w-auto">Quero o site da minha oficina</a>
        </article>

        <article class="card p-6 sm:p-8">
          <h3 class="text-lg font-semibold">Prefere pagar à vista?</h3>
          <p class="mt-2 text-sm text-slate-400">O mesmo site, sem mensalidade:</p>
          <p class="mt-5 font-display text-4xl font-bold text-white">{oferta.aVista}</p>
          <p class="mt-2 text-sm text-slate-300">pagamento único</p>
          <p class="mt-6 border-t border-line pt-4 text-xs text-slate-400">Depois dos 30 dias de ajustes, cada alteração custa {oferta.avulsa}. Domínio próprio (.com.br), se quiser, é pago à parte.</p>
        </article>
      </div>
      <p class="mt-6 text-xs text-slate-400">Alteração: trocar preços, fotos, horários, telefone ou incluir um serviço na lista. Página ou seção nova é orçada à parte.</p>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Como funciona</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Três passos até o seu site no ar</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {passos.map((p, i) => (
          <li class="card p-6">
            <span class="font-display text-sm font-semibold text-gradient">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-semibold">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Dúvidas -->
  <section class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site max-w-3xl">
      <p class="eyebrow">Dúvidas</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Perguntas comuns</h2>
      <div class="mt-10 divide-y divide-line border-y border-line">
        {duvidas.map((d) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
              {d.p}
              <span class="text-violet-300 transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{d.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Chamada final -->
  <section class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site text-center">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold sm:text-4xl">Vamos colocar sua oficina no mapa?</h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-400">Chame no WhatsApp e conte quais serviços você faz. A conversa é sem compromisso.</p>
      <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary mt-8 !px-8 !py-4 text-base">Fale com a VN Bueno Digital</a>
    </div>
  </section>
</Base>
