---
// Página para oficinas mecânicas. Caso real: Garagem NotreDame (projeto em andamento, sem fechamento —
// ver CLAUDE.md §5; não chamar de cliente).
// Oferta para oficinas aprovada pelo fundador em 11/11/2026 — ver CLAUDE.md §8. Mudou? Atualizar `oferta` abaixo.
import Base from '../layouts/Base.astro';
import { site, linkWhatsApp } from '../data/site';

const mensagem = 'Olá! Vi a página para oficinas da VN Bueno Digital e quero um site para a minha oficina.';
const exemplo = 'https://garagemnotredame.vercel.app';

const recursos = [
  { titulo: 'Orçamento de cada serviço no WhatsApp', texto: 'O cliente toca em "Freio" ou "Suspensão" e a mensagem já chega pronta, dizendo o serviço que ele quer.' },
  { titulo: 'Fotos e vídeo reais da sua equipe', texto: 'Quem vê a oficina de verdade, com a equipe trabalhando, confia mais. As fotos abrem em tela cheia e deslizam para o lado.' },
  { titulo: '"Aberto agora" no topo do site', texto: 'O site mostra se a oficina está aberta naquele momento, pelo seu horário de funcionamento.' },
  { titulo: 'Como chegar e horários', texto: 'Mapa, rota no Google Maps e os horários da semana, para o cliente encontrar você sem precisar ligar.' },
  { titulo: 'Feito para o celular', texto: 'Quem procura mecânico normalmente está no celular, muitas vezes com o carro parado. O site foi pensado para essa tela.' },
  { titulo: 'Preparado para o Google', texto: 'O conteúdo é lido pelo Google, o que ajuda quem pesquisa "mecânica" na sua região a encontrar a sua oficina.' },
];

const caso = {
  nome: 'Garagem NotreDame',
  segmento: 'Oficina mecânica em Taboão da Serra, SP',
  imagem: '/portfolio/garagem-notredame.webp',
  url: exemplo,
  rotulo: 'Projeto em andamento',
  destaques: ['Orçamento por serviço no WhatsApp', 'Fotos e vídeo reais da equipe', 'Selo "aberto agora"', 'Mapa e horários'],
};

const oferta = {
  implantacao: 'R$ 500',
  servicosInclusos: 10,
  mensalidade: 'R$ 150',
  alteracoesMes: 2,
  aVista: 'R$ 2.200',
  avulsa: 'R$ 80',
};

const destaques = ['Orçamento por serviço no WhatsApp', 'Fotos e vídeo reais da equipe', 'Selo de "aberto agora"', 'Mapa, rota e horários'];

// Leque do topo (telas reais da Garagem): o início no meio, na frente.
const celulares = [
  { alt: 'Serviços da Garagem NotreDame no celular, com botão de orçamento', imagem: '/portfolio/garagem-servicos-celular.webp', classe: 'left-0 z-10 translate-y-[9%] -rotate-[7deg] opacity-90' },
  { alt: 'Galeria com fotos reais da equipe da Garagem NotreDame no celular', imagem: '/portfolio/garagem-galeria-celular.webp', classe: 'right-0 z-10 translate-y-[9%] rotate-[7deg] opacity-90' },
  { alt: 'Início do site da Garagem NotreDame no celular', imagem: '/portfolio/garagem-notredame-celular.webp', classe: 'left-1/2 z-20 -translate-x-1/2', principal: true },
];

const passos = [
  { titulo: 'Conversa rápida', texto: 'Você conta quais serviços faz, em que região atende e o horário da oficina.' },
  { titulo: 'Fotos e informações', texto: 'Você manda fotos e vídeos da oficina e da equipe. Pode ser do celular; a gente orienta como tirar.' },
  { titulo: 'Site no ar', texto: 'Montamos, você revisa e aprova, e o site vai para o ar com o seu WhatsApp e endereço.' },
];

const duvidas = [
  {
    p: 'Preciso de fotos profissionais?',
    r: 'Não. Fotos e vídeos feitos no celular, da sua equipe trabalhando de verdade, funcionam muito bem e passam mais confiança que banco de imagem.',
  },
  {
    p: 'O cliente consegue agendar pelo site?',
    r: 'O site leva o cliente direto para o seu WhatsApp, já dizendo qual serviço ele quer. Aí vocês combinam o horário na conversa, do jeito que você já atende hoje.',
  },
  {
    p: 'O que a mensalidade cobre?',
    r: `Manter o site no ar (hospedagem), o suporte pelo WhatsApp, a correção de qualquer defeito enquanto o plano estiver ativo e até ${oferta.alteracoesMes} alterações por mês, como trocar preços, fotos e horários ou incluir um serviço. As alterações não acumulam para o mês seguinte. O detalhe fica no contrato.`,
  },
  {
    p: 'Posso pagar à vista, sem mensalidade?',
    r: `Sim: ${oferta.aVista} em pagamento único. Você tem 30 dias de ajustes depois da entrega e, depois disso, cada alteração custa ${oferta.avulsa}.`,
  },
  {
    p: `E se eu tiver mais de ${oferta.servicosInclusos} serviços?`,
    r: 'A gente conversa: dá para agrupar serviços parecidos ou incluir mais itens no orçamento da implantação.',
  },
  {
    p: 'Posso ter um site exclusivo, só meu?',
    r: 'Pode. A implantação de entrada usa o nosso modelo de site para oficinas, personalizado com a sua marca. Um layout exclusivo, desenhado do zero, é um site sob medida, com valor próprio definido na proposta.',
  },
  {
    p: 'Em quanto tempo o site fica pronto?',
    r: `Em até ${site.prazoSiteDiasUteis} dias úteis, contados a partir do recebimento das fotos e informações.`,
  },
  {
    p: 'E se eu cancelar a mensalidade?',
    r: 'O plano com mensalidade é um contrato: se ele for cancelado, o site sai do ar. O domínio (.com.br), quando houver, continua no seu nome e passamos para você a gestão dele. Tudo isso fica por escrito no contrato antes de começar.',
  },
  {
    p: 'Preciso ter domínio próprio (.com.br)?',
    r: `Não é obrigatório para começar. Se quiser um endereço próprio, o domínio .com.br custa ${site.dominioAno} por ano: nós registramos, configuramos e renovamos, sempre no seu nome.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: duvidas.map((d) => ({ '@type': 'Question', name: d.p, acceptedAnswer: { '@type': 'Answer', text: d.r } })),
  },
];
---

<Base
  titulo="Site para oficina mecânica"
  descricao={`Site para oficina mecânica com orçamento de cada serviço direto no WhatsApp, fotos reais da equipe, horários e mapa. Implantação ${oferta.implantacao} e mensalidade ${oferta.mensalidade}.`}
  jsonLd={jsonLd}
>
  <!-- Topo -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[820px] -translate-x-1/2 rounded-full bg-violet-600/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-40 top-40 h-[420px] w-[420px] rounded-full bg-cyan-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="container-site relative grid items-center gap-14 py-14 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:gap-10">
      <div>
        <p class="eyebrow">Para oficinas mecânicas</p>
        <h1 class="mt-5 text-[2.6rem] font-bold leading-[1.04] tracking-tight sm:text-[3.3rem]">
          Carro parado não espera. <span class="text-gradient">O orçamento também não.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
          O cliente toca no serviço (freio, motor, suspensão) e o pedido de orçamento <strong class="text-white">chega no seu WhatsApp já pronto</strong>. Com fotos reais da equipe, horário e mapa.
        </p>

        <ul class="mt-7 grid max-w-xl gap-x-6 gap-y-3 text-sm text-slate-200 sm:grid-cols-2">
          {destaques.map((d) => (
            <li class="flex items-center gap-2.5">
              <svg viewBox="0 0 20 20" class="h-5 w-5 shrink-0 text-cyan-300" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" /></svg>
              {d}
            </li>
          ))}
        </ul>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary !px-7 !py-4 text-base">Quero o site da minha oficina</a>
          <a href={exemplo} target="_blank" rel="noopener" class="btn-ghost !px-7 !py-4 text-base">
            Ver um exemplo <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
          </a>
        </div>

        <a href="#preco" class="group mt-7 inline-flex flex-wrap items-baseline gap-x-2 gap-y-1 rounded-2xl border border-line bg-ink-900/70 px-5 py-3.5 text-sm text-slate-400 backdrop-blur transition hover:border-violet-500/60">
          <span class="font-display text-2xl font-bold text-white">{oferta.mensalidade}<span class="text-sm font-semibold text-slate-400">/mês</span></span>
          <span>+ implantação <strong class="text-white">{oferta.implantacao}</strong></span>
          <span>ou à vista <strong class="text-white">{oferta.aVista}</strong></span>
          <span class="text-violet-300 transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Três telas da Garagem no celular, em leque -->
      <div class="relative mx-auto w-full max-w-[520px]">
        <div class="relative aspect-[5/5.4]">
          {celulares.map((c) => (
            <div class={`absolute top-0 w-[44%] ${c.classe}`}>
              <div class="rounded-[1.9rem] border border-line bg-ink-900 p-2 shadow-2xl shadow-black/60">
                <img src={c.imagem} alt={c.alt} width="390" height="844" loading={c.principal ? 'eager' : 'lazy'} decoding="async" class="w-full rounded-[1.5rem]" />
              </div>
            </div>
          ))}

          <!-- Balão: a mensagem que o site da Garagem envia de verdade -->
          <div class="absolute -left-2 bottom-[14%] z-30 max-w-[220px] rounded-2xl rounded-bl-sm border border-emerald-400/30 bg-[#0b2b22]/95 px-4 py-3 text-xs leading-snug text-emerald-50 shadow-xl shadow-black/50 backdrop-blur sm:-left-6">
            <p class="mb-1 flex items-center gap-1.5 font-semibold text-emerald-300">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z" /></svg>
              WhatsApp
            </p>
            "Olá! Vim pelo site e gostaria de um orçamento de <strong>Freio</strong>."
          </div>
        </div>
        <p class="mt-2 text-center text-xs text-slate-500">Garagem NotreDame (projeto em andamento): início, serviços e fotos reais da equipe.</p>
      </div>
    </div>
  </section>

  <!-- O que o site tem -->
  <section class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">O que o site tem</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Tudo o que o motorista precisa para <span class="text-gradient">escolher sua oficina</span></h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {recursos.map((r) => (
          <article class="card card-vivo p-6">
            <h3 class="text-lg font-semibold">{r.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{r.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Caso real -->
  <section id="exemplo" class="border-t border-line/60 secao-alt py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Exemplo real</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Garagem NotreDame, em Taboão da Serra</h2>
      <p class="mt-4 max-w-2xl text-slate-400">Oficina de verdade, com fotos e vídeo da própria equipe. Abra no celular e teste: toque num serviço e veja a mensagem chegar pronta.</p>
      <article class="card mt-12 grid overflow-hidden lg:grid-cols-[1.2fr_1fr]">
        <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-ink-800 lg:aspect-auto lg:border-b-0 lg:border-r">
          <img src={caso.imagem} alt={`Site ${caso.nome}`} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
          <span class="absolute bottom-3 left-3 rounded-full border border-white/10 bg-ink-950/80 px-3 py-1 text-xs text-slate-200 backdrop-blur">{caso.rotulo}</span>
        </div>
        <div class="flex flex-col p-6 sm:p-8">
          <p class="text-xs font-medium text-violet-300">{caso.segmento}</p>
          <h3 class="mt-1 text-2xl font-semibold">{caso.nome}</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {caso.destaques.map((d) => <li class="rounded-lg bg-ink-800 px-2.5 py-1 text-xs text-slate-300">{d}</li>)}
          </ul>
          <div class="mt-auto flex flex-wrap gap-3 pt-8">
            <a href={caso.url} target="_blank" rel="noopener" class="btn-ghost !px-4 !py-2.5">
              Ver o site <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
            </a>
            <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary !px-4 !py-2.5">Quero um assim</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Preço -->
  <section id="preco" class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Investimento</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Quanto <span class="text-gradient">custa</span></h2>

      <div class="mt-12 grid gap-5 lg:grid-cols-[1.3fr_1fr]">
        <article class="card !border-violet-400/70 !from-violet-600/30 !to-ink-900 shadow-[0_30px_70px_-30px_rgb(124_58_237/0.7)] p-6 sm:p-8">
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <p class="text-sm text-slate-400">Implantação</p>
              <p class="mt-1 font-display text-4xl font-bold text-white">{oferta.implantacao}</p>
              <p class="mt-2 text-sm text-slate-300">Pagamento único. Modelo pronto com a sua marca, até {oferta.servicosInclusos} serviços, galeria de fotos e vídeo, horários e mapa</p>
            </div>
            <div>
              <p class="text-sm text-slate-400">Mensalidade</p>
              <p class="mt-1 font-display text-4xl font-bold text-white">{oferta.mensalidade}<span class="text-lg font-semibold text-slate-400">/mês</span></p>
              <p class="mt-2 text-sm text-slate-300">site no ar, suporte pelo WhatsApp e {oferta.alteracoesMes} alterações por mês</p>
            </div>
          </div>
          <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary mt-8 w-full sm:w-auto">Quero o site da minha oficina</a>
        </article>

        <article class="card p-6 sm:p-8">
          <h3 class="text-lg font-semibold">Prefere pagar à vista?</h3>
          <p class="mt-2 text-sm text-slate-400">O mesmo site, sem mensalidade:</p>
          <p class="mt-5 font-display text-4xl font-bold text-white">{oferta.aVista}</p>
          <p class="mt-2 text-sm text-slate-300">pagamento único</p>
          <p class="mt-6 border-t border-line pt-4 text-xs text-slate-400">Depois dos 30 dias de ajustes, cada alteração custa {oferta.avulsa}. Domínio próprio (.com.br), se quiser: {site.dominioAno} por ano, registrado no seu nome.</p>
        </article>
      </div>
<p class="mt-5 rounded-xl border border-violet-500/30 bg-violet-600/10 p-4 text-sm leading-relaxed text-slate-300"><strong class="text-white">Modelo pronto ou sob medida?</strong> A implantação de {oferta.implantacao} usa o modelo do site da Garagem NotreDame, personalizado com o seu logo, cores, fotos, serviços e contatos. A estrutura das páginas segue o modelo. Quer um layout exclusivo, desenhado do zero só para a sua oficina? É um site <strong class="text-white">sob medida</strong>, com orçamento à parte.</p>
      <p class="mt-6 text-xs text-slate-400">Alteração: trocar preços, fotos, horários, telefone ou incluir um serviço na lista. Página ou seção nova é orçada à parte.</p>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="border-t border-line/60 secao-alt py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Como funciona</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Três passos até o <span class="text-gradient">seu site no ar</span></h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {passos.map((p, i) => (
          <li class="card card-vivo p-6">
            <span class="font-display text-sm font-semibold text-gradient">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-semibold">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Dúvidas -->
  <section class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site max-w-3xl">
      <p class="eyebrow">Dúvidas</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Perguntas <span class="text-gradient">comuns</span></h2>
      <div class="mt-10 divide-y divide-line border-y border-line">
        {duvidas.map((d) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
              {d.p}
              <span class="text-violet-300 transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{d.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Chamada final -->
  <section class="border-t border-line/60 secao-alt py-20 sm:py-24">
    <div class="container-site text-center">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold sm:text-4xl">Vamos colocar sua oficina <span class="text-gradient">no mapa?</span></h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-400">Chame no WhatsApp e conte quais serviços você faz. A conversa é sem compromisso.</p>
      <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary mt-8 !px-8 !py-4 text-base">Fale com a VN Bueno Digital</a>
    </div>
  </section>
</Base>
