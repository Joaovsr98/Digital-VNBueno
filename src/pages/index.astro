<script>
  import '../scripts/metodo-cena';
  import '../scripts/topo-cena';
</script>

<script>
  // Filtro do portfólio por tipo de negócio. Sem JS, os botões ficam escondidos e tudo aparece.
  const filtros = document.getElementById('filtros');
  if (filtros) {
    filtros.classList.remove('hidden');
    filtros.classList.add('flex');
    const botoes = filtros.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    const cards = document.querySelectorAll<HTMLElement>('#portfolio [data-categoria]');
    botoes.forEach((botao) =>
      botao.addEventListener('click', () => {
        const filtro = botao.dataset.filtro;
        botoes.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));
        cards.forEach((card) => {
          card.hidden = filtro !== 'todos' && card.dataset.categoria !== filtro;
        });
        window.dispatchEvent(new Event('vitrine:filtro'));
      }),
    );
  }

  // Vitrine em painéis (computador): passar o mouse, clicar ou focar abre o painel.
  // Troca sozinha a cada 7 s, parando com o mouse em cima, fora da tela ou com "reduzir movimento".
  const vitrine = document.getElementById('vitrine');
  if (vitrine) {
    const paineis = Array.from(vitrine.querySelectorAll<HTMLElement>('[data-painel]'));
    const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TEMPO = 7000;
    let pausado = false;
    let visivel = false;
    let timer = 0;

    const visiveis = () => paineis.filter((p) => !p.hidden);
    const abrir = (alvo: HTMLElement) => {
      paineis.forEach((p) => {
        p.toggleAttribute('data-aberto', p === alvo);
        p.classList.remove('contando');
      });
      void alvo.offsetWidth; // reinicia a barra
      if (!reduzido && !pausado && visivel) alvo.classList.add('contando');
    };
    const proximo = () => {
      const lista = visiveis();
      if (lista.length < 2) return;
      const atual = lista.findIndex((p) => p.hasAttribute('data-aberto'));
      abrir(lista[(atual + 1) % lista.length]);
    };
    const agendar = () => {
      window.clearInterval(timer);
      if (reduzido || pausado || !visivel) return;
      timer = window.setInterval(proximo, TEMPO);
    };

    paineis.forEach((p) => {
      p.addEventListener('mouseenter', () => abrir(p));
      p.addEventListener('click', () => abrir(p));
      p.addEventListener('focus', () => abrir(p));
      p.addEventListener('keydown', (e) => {
        if (e.target !== p) return;
        const lista = visiveis();
        const i = lista.indexOf(p);
        if (e.key === 'ArrowRight' && lista[i + 1]) { e.preventDefault(); lista[i + 1].focus(); }
        if (e.key === 'ArrowLeft' && lista[i - 1]) { e.preventDefault(); lista[i - 1].focus(); }
      });
    });
    vitrine.addEventListener('mouseenter', () => { pausado = true; agendar(); paineis.forEach((p) => p.classList.remove('contando')); });
    vitrine.addEventListener('mouseleave', () => { pausado = false; agendar(); const a = paineis.find((p) => p.hasAttribute('data-aberto')); if (a) abrir(a); });
    new IntersectionObserver(([e]) => {
      visivel = e.isIntersecting;
      agendar();
      const a = paineis.find((p) => p.hasAttribute('data-aberto'));
      if (a) abrir(a);
    }, { threshold: 0.3 }).observe(vitrine);
    document.addEventListener('visibilitychange', () => { visivel = !document.hidden; agendar(); });
    window.addEventListener('vitrine:filtro', () => {
      const lista = visiveis();
      if (lista.length && !lista.some((p) => p.hasAttribute('data-aberto'))) abrir(lista[0]);
      agendar();
    });
  }
</script>
