---
import Base from '../layouts/Base.astro';
import Orcamento from '../components/Orcamento.astro';
import Galeria, { type ItemGaleria } from '../components/Galeria.astro';
import fs from 'node:fs';
import { site, linkWhatsApp } from '../data/site';
import { projetos, rotuloTipo, categorias, mensagemInteresse, type Categoria } from '../data/projetos';

const servicos = [
  {
    titulo: 'Sites institucionais',
    texto: 'Um site profissional que apresenta o seu negócio, funciona bem no celular e ajuda clientes a encontrarem você no Google.',
    itens: ['Visual alinhado à sua marca', 'Botão de WhatsApp e formulário', 'Configuração de domínio e hospedagem'],
    icone: 'M3 5h18v12H3zM8 21h8M12 17v4',
  },
  {
    titulo: 'Landing pages',
    texto: 'Páginas focadas em um objetivo: divulgar um lançamento, apresentar um serviço ou receber contatos de anúncios.',
    itens: ['Ideal para campanhas pagas', 'Captação de contatos', 'Carregamento rápido'],
    icone: 'M4 4h16v16H4zM4 9h16M9 9v11',
  },
  {
    titulo: 'Sistemas web',
    texto: 'Ferramentas sob medida para organizar a rotina: pedidos, agendamentos, clientes, estoque ou finanças.',
    itens: ['Painéis administrativos', 'Cadastro e controle de clientes', 'Acesso pelo navegador'],
    icone: 'M4 6h16M4 12h10M4 18h7M17 15l3 3-3 3',
  },
  {
    titulo: 'Aplicativos',
    texto: 'Aplicações para celular e computador, no formato que fizer mais sentido para o seu caso e o seu orçamento.',
    itens: ['Web responsivo ou PWA', 'Aplicativo mobile quando necessário', 'Integração com sistemas'],
    icone: 'M7 2h10v20H7zM11 18h2',
  },
  {
    titulo: 'Manutenção e suporte',
    texto: 'Depois da entrega, cuidamos do seu site ou sistema para ele continuar no ar, atualizado e seguro.',
    itens: ['Pequenas alterações', 'Correções e atualizações', 'Acompanhamento da hospedagem'],
    icone: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z',
  },
];

const segmentos = [
  {
    titulo: 'Corretores e imobiliárias',
    texto: 'Sites com vitrine de imóveis, landing pages de lançamentos, captação de interessados e atendimento pelo WhatsApp.',
    destaque: true,
    link: { href: '/corretores', rotulo: 'Ver o site para corretores' },
  },
  {
    titulo: 'Oficinas mecânicas',
    texto: 'Site com orçamento de cada serviço no WhatsApp, fotos reais da equipe, horários e mapa de como chegar.',
    link: { href: '/oficinas', rotulo: 'Ver o site para oficinas' },
  },
  {
    titulo: 'Clínicas de estética',
    texto: 'Uma página para cada procedimento, sua formação em destaque e avaliação marcada pelo WhatsApp.',
    link: { href: '/estetica', rotulo: 'Ver o site para estética' },
  },
  {
    titulo: 'Restaurantes e delivery',
    texto: 'Cardápio digital, site do restaurante e sistemas de pedidos para organizar o atendimento.',
  },
  {
    titulo: 'Comércio e serviços',
    texto: 'Sites, agendamento online e sistemas simples para controlar clientes e a rotina do negócio.',
  },
];

const etapas = [
  { titulo: 'Entendimento', texto: 'Conversamos sobre o seu negócio, o objetivo do projeto e o que já existe.' },
  { titulo: 'Planejamento', texto: 'Você recebe uma proposta com escopo, prazo, valor e o que está incluído.' },
  { titulo: 'Desenvolvimento', texto: 'Construímos o projeto e mostramos o andamento para você acompanhar.' },
  { titulo: 'Testes', texto: 'Revisamos no celular e no computador e ajustamos o que for preciso.' },
  { titulo: 'Entrega e suporte', texto: 'Publicamos, explicamos como usar e oferecemos manutenção se quiser.' },
];

const duvidas = [
  {
    p: 'Quanto custa um site ou sistema?',
    r: 'Landing pages começam em R$ 800 e sites institucionais em R$ 1.500. Sistemas e aplicativos são orçados conforme o projeto. Depois de entender a sua necessidade, enviamos uma proposta com valor fechado e tudo o que está incluído.',
  },
  {
    p: 'Preciso já ter domínio e hospedagem?',
    r: 'Não. Ajudamos a registrar o domínio e configurar a hospedagem. Os custos desses serviços e quem fica responsável por eles ficam descritos na proposta.',
  },
  {
    p: 'Vocês atendem só o mercado imobiliário?',
    r: 'Não. Temos experiência com o setor imobiliário, mas desenvolvemos projetos para empresas e profissionais de diferentes áreas.',
  },
  {
    p: 'Consigo alterar o site depois da entrega?',
    r: 'Sim. Todo site tem 30 dias de ajustes depois da entrega. Depois disso, você pode contratar o plano de manutenção (R$ 179,99 por mês, com 2 alterações básicas por mês) ou pedir alterações avulsas quando precisar.',
  },
  {
    p: 'O que é uma alteração básica?',
    r: 'Trocar textos, fotos, telefone, endereço ou horários, ou incluir um item numa lista que já existe (como um novo serviço). Página nova, seção nova ou mudança de layout são orçadas à parte. As alterações do plano não acumulam para o mês seguinte.',
  },
  {
    p: 'Como começa um projeto?',
    r: 'Basta preencher o pedido de orçamento ou chamar no WhatsApp. Marcamos uma conversa rápida para entender o que você precisa, sem compromisso.',
  },
];

// Prints pequenos (640px) para o mosaico do topo.
const mosaico = [
  { src: '/portfolio/mini/bueno-imoveis.webp', pos: 'left-0 top-0 -rotate-3' },
  { src: '/portfolio/mini/garagem-notredame.webp', pos: 'right-0 top-24 rotate-2' },
  { src: '/portfolio/mini/inv-racing.webp', pos: 'left-6 bottom-0 -rotate-1' },
];

const visiveis = projetos.filter((p) => p.publicar);
const sites = visiveis.filter((p) => p.categoria !== 'sistemas');
const produtos = visiveis.filter((p) => p.categoria === 'sistemas');
// Galeria em tela cheia: tela do computador + tela do celular de cada projeto (quando existir o print).
const temArquivo = (src: string) => fs.existsSync(process.cwd() + '/public' + src);
const galeria: ItemGaleria[] = [];
const indiceGaleria = new Map<string, number>();
for (const p of [...sites, ...produtos]) {
  if (!p.imagem) continue;
  indiceGaleria.set(p.nome, galeria.length);
  galeria.push({ src: p.imagem, alt: p.nome + ' no computador', legenda: p.nome });
  const cel = p.imagem.replace('.webp', '-celular.webp');
  if (temArquivo(cel)) galeria.push({ src: cel, alt: p.nome + ' no celular', legenda: p.nome, celular: true });
}

// "Padrão VN Bueno Digital": só o que já entregamos de verdade nos projetos.
const padrao = [
  { titulo: 'WhatsApp que já chega com o pedido', texto: 'Cada botão envia uma mensagem pronta dizendo o que o cliente quer: o serviço, o produto ou o orçamento.', icone: 'M21 12a9 9 0 0 1-13.4 7.9L3 21l1.1-4.6A9 9 0 1 1 21 12zM8 10h8M8 14h5' },
  { titulo: 'Pensado primeiro para o celular', texto: 'A maioria dos seus clientes chega pelo celular. Botões grandes, leitura fácil e nada saindo da tela.', icone: 'M7 2h10v20H7zM11 18h2' },
  { titulo: 'Nota máxima no Google Lighthouse', texto: 'Nossos sites mais recentes tiram 100 em acessibilidade, boas práticas e SEO na ferramenta de avaliação do Google.', icone: 'M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z' },
  { titulo: 'Fotos que ampliam e deslizam', texto: 'Galeria em tela cheia: o cliente toca na foto e passa para as próximas com o dedo, como num aplicativo.', icone: 'M3 5h18v14H3zM3 15l5-5 4 4 3-3 6 6M15.5 9.5h.01' },
  { titulo: 'LGPD em dia', texto: 'Formulário com consentimento e página de privacidade explicando o que é feito com os dados.', icone: 'M12 3l7 4v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V7zM9 12l2 2 4-4' },
  { titulo: '30 dias de ajustes', texto: 'Depois da entrega, você usa o site no dia a dia e a gente ajusta o que for preciso, sem custo extra.', icone: 'M4 4h16v16H4zM4 9h16M9 4v5M15 4v5M8 14l2.5 2.5L16 12' },
];

const categoriasSites = (Object.keys(categorias) as Categoria[]).filter(
  (c) => c !== 'sistemas' && sites.some((p) => p.categoria === c),
);

// Preços de referência (CLAUDE.md §8). "A partir de" = piso; o valor final sai na proposta.
const planos = [
  {
    titulo: 'Landing page',
    para: 'Uma página focada em um objetivo: lançamento, serviço ou anúncio.',
    prefixo: 'a partir de',
    preco: 'R$ 800',
    itens: ['Visual alinhado à sua marca', 'Botão de WhatsApp e formulário', 'Feita para celular e computador', 'Pronta para anúncios', 'Configuração de domínio e hospedagem'],
    cta: 'Quero uma landing page',
    mensagem: 'Olá! Vi os preços no site da VN Bueno Digital e quero uma landing page.',
    destaque: false,
  },
  {
    titulo: 'Site institucional',
    para: 'O site completo do seu negócio, para aparecer no Google e receber contatos.',
    prefixo: 'a partir de',
    preco: 'R$ 1.500',
    itens: ['Páginas sob medida (início, serviços, sobre, contato)', 'WhatsApp, formulário e mapa', 'Feito para celular e computador', 'Preparado para o Google', 'Configuração de domínio e hospedagem'],
    cta: 'Quero um site',
    mensagem: 'Olá! Vi os preços no site da VN Bueno Digital e quero um site institucional.',
    destaque: true,
  },
  {
    titulo: 'Sistemas e aplicativos',
    para: 'Pedidos, agendamentos, clientes, estoque ou finanças, do jeito que a sua empresa trabalha.',
    prefixo: 'valor conforme o projeto',
    preco: 'Sob orçamento',
    itens: ['Levantamento do que você precisa', 'Telas para cada tipo de usuário', 'Acesso pelo navegador ou celular', 'Entrega em etapas'],
    cta: 'Quero um sistema',
    mensagem: 'Olá! Vi o site da VN Bueno Digital e quero conversar sobre um sistema para o meu negócio.',
    destaque: false,
  },
  {
    titulo: 'Manutenção',
    para: 'Para o seu site continuar no ar, atualizado e com alguém cuidando dele.',
    prefixo: 'plano mensal',
    preco: 'R$ 179,99',
    itens: ['2 alterações básicas por mês', 'Correções e atualizações', 'Acompanhamento da hospedagem', 'Suporte pelo WhatsApp'],
    cta: 'Saber mais',
    mensagem: 'Olá! Vi o site da VN Bueno Digital e quero saber sobre o plano de manutenção.',
    destaque: false,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: site.nome,
    url: site.url,
    description: site.descricao,
    logo: new URL('/vn-bueno-digital.png', site.url).href,
    image: new URL('/og.jpg', site.url).href,
    telephone: '+' + site.whatsapp,
    email: site.email,
    priceRange: 'R$',
    areaServed: 'BR',
    address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
    sameAs: [site.instagram, site.tiktok].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.nome,
    url: site.url,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: duvidas.map((d) => ({
      '@type': 'Question',
      name: d.p,
      acceptedAnswer: { '@type': 'Answer', text: d.r },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[820px] -translate-x-1/2 rounded-full bg-violet-600/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-20 left-[15%] h-[300px] w-[420px] rounded-full bg-blue-600/15 blur-3xl" aria-hidden="true"></div>

    <div class="container-site relative py-20 sm:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-[1.35fr_1fr]">
      <div>
      <p class="font-display text-xl font-semibold tracking-tight sm:text-2xl"><span class="text-gradient">{site.slogan}</span></p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-[1.08] sm:text-6xl lg:text-5xl xl:text-6xl">
        Transformamos ideias em <span class="text-gradient">soluções digitais</span> para o seu negócio.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
        A VN Bueno Digital desenvolve sites, landing pages, sistemas e aplicativos sob medida para empresas e profissionais
        que querem uma presença digital profissional e processos mais organizados.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#orcamento" class="btn-primary !px-6 !py-3.5 text-base">Solicite seu orçamento</a>
        <a href="#portfolio" class="btn-ghost !px-6 !py-3.5 text-base">Conheça nossos projetos</a>
      </div>
      </div>

      <!-- Mosaico de projetos (só no computador). <picture> com media: abaixo de 1024px o navegador
           usa o GIF vazio do <img> e não baixa os prints (só esconder com CSS não evita o download). -->
      <a href="#portfolio" class="relative hidden h-[420px] lg:block" aria-label="Ver projetos do portfólio">
        {mosaico.map((m) => (
          <picture>
            <source media="(min-width: 1024px)" srcset={m.src} type="image/webp" />
            <img
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
              alt=""
              width="640"
              height="360"
              decoding="async"
              class={`absolute w-[78%] rounded-xl border border-line shadow-2xl shadow-black/60 transition duration-300 hover:z-10 hover:scale-[1.03] ${m.pos}`}
            />
          </picture>
        ))}
      </a>
      </div>

      <ul class="mt-14 flex flex-wrap gap-x-8 gap-y-3 text-sm text-slate-400">
        {['Projetos sob medida', 'Feito para celular e computador', 'Proposta clara, sem surpresas', 'Suporte após a entrega'].map((t) => (
          <li class="flex items-center gap-2">
            <svg viewBox="0 0 20 20" class="h-4 w-4 text-violet-400" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" /></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Serviços -->
  <section id="servicos" class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Serviços</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">O que a VN Bueno Digital pode fazer pelo seu negócio</h2>
      <p class="mt-4 max-w-2xl text-slate-400">Da primeira página na internet a um sistema completo para a sua operação.</p>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {servicos.map((s) => (
          <article class="card group p-6 transition hover:border-violet-500/50">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-ink-800 text-violet-300">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icone} /></svg>
            </div>
            <h3 class="mt-5 text-lg font-semibold">{s.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.texto}</p>
            <ul class="mt-4 space-y-1.5 text-sm text-slate-300">
              {s.itens.map((i) => <li class="flex gap-2"><span class="text-violet-400" aria-hidden="true">›</span>{i}</li>)}
            </ul>
          </article>
        ))}
        <a href="#orcamento" class="card flex flex-col justify-between bg-gradient-to-br from-blue-600/15 to-violet-600/20 p-6 transition hover:border-violet-400/60">
          <div>
            <h3 class="text-lg font-semibold">Tem outra ideia?</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">Conte o que você precisa. Se for possível resolver com software, a gente conversa.</p>
          </div>
          <span class="mt-6 text-sm font-semibold text-white">Tire sua ideia do papel →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Segmentos -->
  <section class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Para quem</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Soluções para diferentes tipos de negócio</h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {segmentos.map((s) => (
          <article class={`card p-6 ${s.destaque ? 'border-violet-500/40 bg-gradient-to-b from-violet-600/10 to-transparent' : ''}`}>
            {s.destaque && <p class="mb-3 text-xs font-semibold text-violet-300">Experiência no setor</p>}
            <h3 class="text-lg font-semibold">{s.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.texto}</p>
            {s.link && (
              <a href={s.link.href} class="mt-4 inline-block text-sm font-semibold text-white hover:text-violet-300">
                {s.link.rotulo} <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Portfólio (sites) -->
  <section id="portfolio" class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Portfólio</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Sites que já construímos</h2>
      <p class="mt-4 max-w-2xl text-slate-400">Veja o que um site parecido pode fazer pelo seu negócio. Gostou de algum? É só pedir um assim.</p>

      <!-- Filtros: só aparecem com JavaScript; sem ele, todos os projetos ficam visíveis. -->
      <div id="filtros" class="mt-8 hidden flex-wrap gap-2" role="group" aria-label="Filtrar por tipo de negócio">
        <button type="button" data-filtro="todos" aria-pressed="true" class="filtro">Todos</button>
        {categoriasSites.map((c) => (
          <button type="button" data-filtro={c} aria-pressed="false" class="filtro">{categorias[c]}</button>
        ))}
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {sites.map((p) => {
          const rotulo = rotuloTipo[p.tipo];
          return (
            <article class="card flex flex-col overflow-hidden" data-categoria={p.categoria}>
              <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-ink-800">
                {p.imagem ? (
                  <button type="button" data-abrir-galeria={indiceGaleria.get(p.nome)} class="group/img block h-full w-full cursor-zoom-in">
                    <img src={p.imagem} alt={`Ampliar as telas do projeto ${p.nome}, no computador e no celular`} loading="lazy" decoding="async" class="h-full w-full object-cover object-top transition duration-500 group-hover/img:scale-[1.03]" />
                    <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-ink-950/80 px-3 py-1 text-xs text-slate-200 backdrop-blur transition group-hover/img:border-violet-400/60" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                      Computador e celular
                    </span>
                  </button>
                ) : (
                  <div class="flex h-full items-center justify-center bg-gradient-to-br from-blue-600/20 via-ink-800 to-violet-600/25">
                    <span class="font-display text-2xl font-semibold text-white/80">{p.nome}</span>
                  </div>
                )}
                {rotulo && (
                  <span class={`absolute bottom-3 left-3 rounded-full border px-3 py-1 text-xs backdrop-blur ${p.tipo === 'modelo' ? 'border-emerald-400/50 bg-emerald-950/85 font-semibold text-emerald-200' : 'border-white/10 bg-ink-950/80 text-slate-200'}`}>{rotulo}</span>
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs font-medium text-violet-300">{p.segmento}</p>
                <h3 class="mt-1 text-xl font-semibold">{p.nome}</h3>
                <p class="mt-3 font-medium leading-snug text-white">{p.resultado}</p>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">{p.descricao}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.destaques.map((d) => <li class="rounded-lg bg-ink-800 px-2.5 py-1 text-xs text-slate-300">{d}</li>)}
                </ul>
                <div class="mt-auto pt-6">
                  <div class="flex flex-wrap items-center gap-3">
                    <a href={linkWhatsApp(mensagemInteresse(p))} target="_blank" rel="noopener" class="btn-primary !px-4 !py-2.5">
                      {p.tipo === 'modelo' ? 'Quero esse modelo' : 'Quero um site assim'}
                    </a>
                    {p.demo && (
                      <a href={p.url} target="_blank" rel="noopener" class="btn-ghost !px-4 !py-2.5">
                        Ver projeto <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
                      </a>
                    )}
                  </div>
                  <p class="mt-4 text-xs text-slate-400">{p.stack.join(' · ')}</p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Padrão VN Bueno Digital -->
  <section id="padrao" class="relative overflow-hidden border-t border-line/60 py-20 sm:py-24">
    <div class="pointer-events-none absolute -right-40 top-10 h-[360px] w-[520px] rounded-full bg-blue-600/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative">
      <p class="eyebrow">Padrão VN Bueno Digital</p>
