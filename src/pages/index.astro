---
import Base from '../layouts/Base.astro';
import Orcamento from '../components/Orcamento.astro';
import PresencaIA from '../components/PresencaIA.astro';
import Galeria, { type ItemGaleria } from '../components/Galeria.astro';
import fs from 'node:fs';
import { inclusos } from '../data/inclusos';
import { site, linkWhatsApp } from '../data/site';
import { projetos, rotuloTipo, categorias, mensagemInteresse, type Categoria } from '../data/projetos';

// Serviços agrupados pelo objetivo do cliente (14/11/2026). Cada card leva à página ou seção do serviço.
const gruposServico = [
  {
    titulo: 'Presença digital',
    texto: 'Para ser encontrado e passar confiança.',
    itens: [
      { titulo: 'Sites institucionais', texto: 'Apresenta o seu negócio, funciona bem no celular e leva o cliente direto para o seu WhatsApp.', icone: 'M3 5h18v12H3zM8 21h8M12 17v4', cor: 'from-blue-500 to-cyan-400', link: '/sites' },
      { titulo: 'Landing pages', texto: 'Uma página focada em um objetivo: lançamento, campanha ou serviço, pronta para receber contatos de anúncios.', icone: 'M4 4h16v16H4zM4 9h16M9 9v11', cor: 'from-violet-500 to-fuchsia-500', link: '#precos' },
    ],
  },
  {
    titulo: 'Gestão do negócio',
    texto: 'Para organizar a rotina e parar de depender de planilha.',
    itens: [
      { titulo: 'Sistemas web', texto: 'Pedidos, agendamentos, clientes, estoque ou finanças, do jeito que a sua empresa trabalha.', icone: 'M4 6h16M4 12h10M4 18h7M17 15l3 3-3 3', cor: 'from-cyan-500 to-blue-600', link: '#produtos' },
      { titulo: 'Aplicativos', texto: 'Para celular e computador, no formato que fizer sentido: web, instalável no celular ou nas lojas.', icone: 'M7 2h10v20H7zM11 18h2', cor: 'from-indigo-500 to-violet-500', link: '#orcamento' },
    ],
  },
  {
    titulo: 'Cuidado contínuo',
    texto: 'Para o site seguir no ar, atualizado e sendo encontrado.',
    itens: [
      { titulo: 'Manutenção e suporte', texto: 'Alterações todo mês, correções, atualizações e hospedagem acompanhada, com resposta pelo WhatsApp.', icone: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z', cor: 'from-sky-500 to-indigo-500', link: '#precos' },
      { titulo: 'Presença no Google e nas IAs', texto: 'Perfil no Google, conteúdo que responde ao seu cliente e medição mensal nas principais IAs.', icone: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20', cor: 'from-emerald-500 to-cyan-500', link: '#presenca' },
    ],
  },
];

const segmentos = [
  {
    titulo: 'Corretores e imobiliárias',
    texto: 'Sites com vitrine de imóveis, landing pages de lançamentos, captação de interessados e atendimento pelo WhatsApp.',
    destaque: true,
    link: { href: '/corretores', rotulo: 'Ver o site para corretores' },
  },
  {
    titulo: 'Oficinas mecânicas',
    texto: 'Site com orçamento de cada serviço no WhatsApp, fotos reais da equipe, horários e mapa de como chegar.',
    link: { href: '/oficinas', rotulo: 'Ver o site para oficinas' },
  },
  {
    titulo: 'Clínicas de estética',
    texto: 'Uma página para cada procedimento, sua formação em destaque e avaliação marcada pelo WhatsApp.',
    link: { href: '/estetica', rotulo: 'Ver o site para estética' },
  },
  {
    titulo: 'Restaurantes e delivery',
    texto: 'Cardápio digital, site do restaurante e sistemas de pedidos para organizar o atendimento.',
  },
  {
    titulo: 'Comércio e serviços',
    texto: 'Sites, agendamento online e sistemas simples para controlar clientes e a rotina do negócio.',
  },
];

// Método em 6 etapas (13/11/2026), adaptado do trabalho da Nariely Marques (repo vnbueno-digital, src/data/method.ts).
const etapas = [
  { titulo: 'Descoberta', texto: 'Entendemos o seu negócio, o objetivo do projeto e o que já existe hoje.' },
  { titulo: 'Estratégia', texto: 'Definimos escopo, prioridades e prazo. Você recebe a proposta com valor e tudo o que está incluído.' },
  { titulo: 'Concepção', texto: 'Desenhamos a solução e as telas antes de programar, para você ver e aprovar.' },
  { titulo: 'Desenvolvimento', texto: 'Construímos o projeto e mostramos o andamento para você acompanhar.' },
  { titulo: 'Validação', texto: 'Testamos no celular e no computador, revisamos a segurança e ajustamos o que for preciso.' },
  { titulo: 'Entrega e evolução', texto: 'Publicamos, explicamos como usar e seguimos com manutenção e melhorias, se você quiser.' },
];

// Quem faz (13/11/2026). Só informação confirmada; sem foto até existir retrato real (moldura com iniciais).
const pessoas = [
  {
    nome: 'João Victor',
    nomeCompleto: 'João Victor dos Santos Rodrigues',
    foco: 'Tecnologia e desenvolvimento',
    resumo: 'Desenvolvimento de sites, aplicações e sistemas sob medida, integrando interfaces, APIs, bancos de dados e infraestrutura para criar soluções digitais eficientes, escaláveis e alinhadas às necessidades de cada negócio.',
    especialidades: ['Desenvolvimento Full Stack', 'Sistemas e plataformas', 'APIs e integrações', 'Bancos de dados', 'Infraestrutura e deploy'],
    iniciais: 'JV',
    foto: '/equipe/joao-victor.webp',
    projetos: '#portfolio',
    tom: 'from-blue-600/40',
  },
  {
    nome: 'Nariely Marques',
    nomeCompleto: 'Nariely Marques Santos',
    foco: 'Estratégia e engenharia',
    resumo: 'Visão multidisciplinar que conecta infraestrutura, território, processos, tecnologia, dados e criação.',
    especialidades: ['Arquitetura e urbanismo', 'Geoprocessamento', 'Gestão de processos', 'Infraestrutura aeroportuária', 'Design e comunicação'],
    iniciais: 'NM',
    tom: 'from-violet-600/45',
    linkedin: 'https://www.linkedin.com/in/nariely-marques-253634150/',
  },
];

// O que entra em todo site (só o que de fato entregamos hoje).
const depois = [
  { titulo: `Resposta em até ${site.respostaEm}`, texto: 'Em horário comercial, pelo WhatsApp, com as próximas etapas.' },
  { titulo: 'Estudamos o seu caso antes da conversa', texto: 'Olhamos o seu Instagram ou site atual e a concorrência da sua região.' },
  { titulo: 'Proposta por escrito', texto: 'Escopo, prazo, valor e tudo o que está incluído, sem letra miúda.' },
];


// IA como apoio e pesquisa: quem faz é a equipe.
const usosIA = ['Pesquisa de referências', 'Organização de ideias e requisitos', 'Apoio na revisão de textos e código'];

const duvidas = [
  {
    p: 'Quanto custa um site ou sistema?',
    r: 'Landing pages começam em R$ 800 e sites institucionais em R$ 1.500. Sistemas e aplicativos são orçados conforme o projeto. Depois de entender a sua necessidade, enviamos uma proposta com valor fechado e tudo o que está incluído.',
  },
  {
    p: 'Preciso já ter domínio e hospedagem?',
    r: `Não. Registramos o domínio .com.br no seu nome por ${site.dominioAno} por ano (com configuração e renovação) e cuidamos da hospedagem. Os custos e quem fica responsável por cada um ficam descritos na proposta.`,
  },
  {
    p: 'Vocês atendem só o mercado imobiliário?',
    r: 'Não. Temos experiência com o setor imobiliário, mas desenvolvemos projetos para empresas e profissionais de diferentes áreas.',
  },
  {
    p: 'Consigo alterar o site depois da entrega?',
    r: 'Sim. Todo site tem 30 dias de ajustes depois da entrega. Depois disso, você pode contratar o plano de manutenção (R$ 179,99 por mês, com 2 alterações básicas por mês) ou pedir alterações avulsas quando precisar.',
  },
  {
    p: 'O que é uma alteração básica?',
    r: 'Trocar textos, fotos, telefone, endereço ou horários, ou incluir um item numa lista que já existe (como um novo serviço). Página nova, seção nova ou mudança de layout são orçadas à parte. As alterações do plano não acumulam para o mês seguinte.',
  },
  {
    p: 'Em quanto tempo o site fica pronto?',
    r: `Em até ${site.prazoSiteDiasUteis} dias úteis, contados a partir do recebimento dos textos, fotos e informações. Sistemas e aplicativos têm o prazo definido na proposta, etapa por etapa.`,
  },
  {
    p: 'O site é meu?',
    r: 'No pagamento à vista, sim: o site é seu e o domínio fica no seu nome. Nos planos com implantação e mensalidade (como os de corretores, oficinas e clínicas), o site fica no ar enquanto o plano estiver ativo. Se o contrato for cancelado, o site sai do ar e o domínio continua seu. Tudo isso fica por escrito no contrato.',
  },
  {
    p: 'Vocês garantem primeiro lugar no Google?',
    r: 'Não, e desconfie de quem garante. Entregamos o site preparado para o Google (conteúdo legível, dados estruturados, velocidade e segurança). A posição depende da concorrência e de trabalho contínuo.',
  },
  {
    p: 'Quem vai fazer o meu site?',
    r: 'O João e a Nariely, sem terceirizar.',
  },
  {
    p: 'O site é feito por inteligência artificial?',
    r: 'Não. O planejamento, o design e a programação são feitos por nós, com a sua marca e o seu conteúdo. Usamos inteligência artificial apenas como ferramenta de apoio e pesquisa: para buscar referências, organizar ideias e ajudar na revisão.',
  },
  {
    p: 'Como começa um projeto?',
    r: `Basta preencher o pedido de orçamento ou chamar no WhatsApp. Respondemos em até ${site.respostaEm} em horário comercial e marcamos uma conversa rápida para entender o que você precisa, sem compromisso.`,
  },
];

const visiveis = projetos.filter((p) => p.publicar);
const sites = visiveis.filter((p) => p.categoria !== 'sistemas');
const produtos = visiveis.filter((p) => p.categoria === 'sistemas');
// Galeria em tela cheia: tela do computador + tela do celular de cada projeto (quando existir o print).
const temArquivo = (src: string) => fs.existsSync(process.cwd() + '/public' + src);
const galeria: ItemGaleria[] = [];
const indiceGaleria = new Map<string, number>();
for (const p of [...sites, ...produtos]) {
  if (!p.imagem) continue;
  indiceGaleria.set(p.nome, galeria.length);
  galeria.push({ src: p.imagem, alt: p.nome + ' no computador', legenda: p.nome });
  const cel = p.imagem.replace('.webp', '-celular.webp');
  if (temArquivo(cel)) galeria.push({ src: cel, alt: p.nome + ' no celular', legenda: p.nome, celular: true });
}

// "Padrão VN Bueno Digital": só o que já entregamos de verdade nos projetos.
const padrao = [
  { titulo: 'WhatsApp que já chega com o pedido', texto: 'Cada botão envia uma mensagem pronta dizendo o que o cliente quer: o serviço, o produto ou o orçamento.', icone: 'M21 12a9 9 0 0 1-13.4 7.9L3 21l1.1-4.6A9 9 0 1 1 21 12zM8 10h8M8 14h5' },
  { titulo: 'Pensado primeiro para o celular', texto: 'A maioria dos seus clientes chega pelo celular. Botões grandes, leitura fácil e nada saindo da tela.', icone: 'M7 2h10v20H7zM11 18h2' },
  { titulo: 'Nota máxima no Google Lighthouse', texto: 'Nossos sites mais recentes tiram 100 em acessibilidade, boas práticas e SEO na ferramenta de avaliação do Google.', icone: 'M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z' },
  { titulo: 'Fotos que ampliam e deslizam', texto: 'Galeria em tela cheia: o cliente toca na foto e passa para as próximas com o dedo, como num aplicativo.', icone: 'M3 5h18v14H3zM3 15l5-5 4 4 3-3 6 6M15.5 9.5h.01' },
  { titulo: 'LGPD em dia', texto: 'Formulário com consentimento e página de privacidade explicando o que é feito com os dados.', icone: 'M12 3l7 4v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V7zM9 12l2 2 4-4' },
  { titulo: '30 dias de ajustes', texto: 'Depois da entrega, você usa o site no dia a dia e a gente ajusta o que for preciso, sem custo extra.', icone: 'M4 4h16v16H4zM4 9h16M9 4v5M15 4v5M8 14l2.5 2.5L16 12' },
];

const categoriasSites = (Object.keys(categorias) as Categoria[]).filter(
  (c) => c !== 'sistemas' && sites.some((p) => p.categoria === c),
);

// Preços de referência (CLAUDE.md §8). "A partir de" = piso; o valor final sai na proposta.
const planos = [
  {
    titulo: 'Landing page',
    para: 'Uma página focada em um objetivo: lançamento, serviço ou anúncio.',
    prefixo: 'a partir de',
    preco: 'R$ 800',
    itens: ['Visual alinhado à sua marca', 'Botão de WhatsApp e formulário', 'Feita para celular e computador', 'Pronta para anúncios', 'Configuração de domínio e hospedagem'],
    cta: 'Quero uma landing page',
    mensagem: 'Olá! Vi os preços no site da VN Bueno Digital e quero uma landing page.',
    destaque: false,
  },
  {
    titulo: 'Site institucional',
    para: 'O site completo do seu negócio, para aparecer no Google e receber contatos.',
    prefixo: 'a partir de',
    preco: 'R$ 1.500',
    itens: ['Páginas sob medida (início, serviços, sobre, contato)', 'WhatsApp, formulário e mapa', 'Feito para celular e computador', 'Preparado para o Google', 'Configuração de domínio e hospedagem'],
    cta: 'Quero um site',
    mensagem: 'Olá! Vi os preços no site da VN Bueno Digital e quero um site institucional.',
    destaque: true,
  },
  {
    titulo: 'Sistemas e aplicativos',
    para: 'Pedidos, agendamentos, clientes, estoque ou finanças, do jeito que a sua empresa trabalha.',
    prefixo: 'valor conforme o projeto',
    preco: 'Sob orçamento',
    itens: ['Levantamento do que você precisa', 'Telas para cada tipo de usuário', 'Acesso pelo navegador ou celular', 'Entrega em etapas'],
    cta: 'Quero um sistema',
    mensagem: 'Olá! Vi o site da VN Bueno Digital e quero conversar sobre um sistema para o meu negócio.',
    destaque: false,
  },
  {
    titulo: 'Manutenção',
    para: 'Para o seu site continuar no ar, atualizado e com alguém cuidando dele.',
    prefixo: 'plano mensal',
    preco: 'R$ 179,99',
    itens: ['2 alterações básicas por mês', 'Correções e atualizações', 'Acompanhamento da hospedagem', 'Suporte pelo WhatsApp'],
    cta: 'Saber mais',
    mensagem: 'Olá! Vi o site da VN Bueno Digital e quero saber sobre o plano de manutenção.',
    destaque: false,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: site.nome,
    url: site.url,
    description: site.descricao,
    logo: new URL('/vn-bueno-digital.png', site.url).href,
    image: new URL('/og.jpg', site.url).href,
    telephone: '+' + site.whatsapp,
    email: site.email,
    priceRange: 'R$',
    areaServed: 'BR',
    address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
    sameAs: [site.instagram, site.tiktok].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.nome,
    url: site.url,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: duvidas.map((d) => ({
      '@type': 'Question',
      name: d.p,
      acceptedAnswer: { '@type': 'Answer', text: d.r },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <!-- Topo: a tecnologia fala primeiro. Partículas 3D que se transformam (motor criado por Nariely
       Marques, cores da VN Bueno). O texto fica mínimo, mas real (H1 visível para o Google).
       Three.js só carrega depois que a página termina de abrir; sem WebGL fica a ilustração estática. -->
  <section id="topo-cena" class="relative isolate flex min-h-[calc(100svh-4rem)] items-end overflow-hidden lg:items-center">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(40%_45%_at_62%_50%,rgb(124_58_237/0.18),transparent_70%)]"></div>
      <svg viewBox="0 0 100 60" preserveAspectRatio="xMidYMid slice" class="topo-fallback absolute inset-0 h-full w-full transition-opacity duration-1000">
        {Array.from({ length: 10 }, (_, i) => (
          <ellipse cx="66" cy="30" rx={4 + i * 4.2} ry={2.6 + i * 2.5} fill="none" stroke={i % 2 ? '#a78bfa' : '#60a5fa'} stroke-opacity={0.45 - i * 0.04} stroke-width=".2" />
        ))}
      </svg>
      <canvas class="absolute inset-x-0 top-0 h-[64%] w-full opacity-0 transition-opacity duration-[1500ms] lg:h-full"></canvas>
      <!-- no computador, a forma some suavemente atrás do texto -->
      <div class="absolute inset-y-0 left-0 hidden w-[55%] bg-gradient-to-r from-ink-950 via-ink-950/75 to-transparent lg:block"></div>
      <!-- leitura do texto no celular, onde a forma fica atrás dele -->
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink-950 via-ink-950/80 to-transparent lg:hidden"></div>
    </div>

    <div class="container-site relative w-full pb-16 pt-24 lg:py-24">
      <div class="max-w-xl">
        <h1 class="text-5xl font-bold leading-[1.02] sm:text-7xl">
          Seu presente <span class="text-gradient">do futuro.</span>
        </h1>
        <p class="mt-5 text-base text-slate-400 sm:text-lg">Sites, sistemas e aplicativos para o seu negócio.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#orcamento" class="btn-primary !px-6 !py-3.5 text-base">Solicite seu orçamento</a>
          <a href="#portfolio" class="btn-ghost !px-6 !py-3.5 text-base">Conheça nossos projetos</a>
        </div>
      </div>
    </div>

    <p class="pointer-events-none absolute bottom-6 right-6 hidden items-center gap-2 font-display text-xs uppercase tracking-[0.14em] text-slate-400 lg:flex" aria-hidden="true">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400"></span>
      <span data-legenda>VN Bueno Digital</span>
    </p>
  </section>

  <!-- Serviços -->
  <section id="servicos" class="secao-clara border-t py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Serviços</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">O que a VN Bueno Digital pode fazer pelo <span class="text-gradient">seu negócio</span></h2>
      <p class="mt-4 max-w-2xl text-slate-400">Da primeira página na internet a um sistema completo para a sua operação.</p>

      <div class="mt-12 divide-y divide-[#c5d4e4] border-t border-[#c5d4e4]">
        {gruposServico.map((g, gi) => (
          <div class="grid gap-6 py-10 lg:grid-cols-[0.8fr_2fr] lg:gap-10">
            <div>
              <p class="font-display text-sm font-semibold text-gradient">0{gi + 1}</p>
              <h3 class="mt-2 text-2xl font-bold">{g.titulo}</h3>
              <p class="mt-2 max-w-xs text-sm text-slate-400">{g.texto}</p>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              {g.itens.map((it) => (
                <a href={it.link} class="card card-vivo group relative flex gap-4 p-6">
                  <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${it.cor} text-white shadow-lg shadow-violet-900/30 transition group-hover:scale-110`}>
                    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={it.icone} /></svg>
                  </div>
                  <div class="pr-6">
                    <h4 class="text-lg font-semibold">{it.titulo}</h4>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{it.texto}</p>
                  </div>
                  <span class="absolute right-5 top-5 flex h-7 w-7 items-center justify-center rounded-full border border-[#c5d4e4] text-violet-500 transition group-hover:border-violet-500 group-hover:bg-violet-500 group-hover:text-white" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <a href="#orcamento" class="escuro card-vivo mt-4 flex flex-col items-start justify-between gap-4 rounded-2xl bg-gradient-to-br from-blue-600 to-violet-700 p-6 shadow-[0_24px_60px_-28px_rgb(124_58_237/0.6)] sm:flex-row sm:items-center">
        <div>
          <h3 class="text-lg font-semibold text-white">Tem outra ideia?</h3>
          <p class="mt-1 text-sm text-blue-50">Conte o que você precisa. Se for possível resolver com software, a gente conversa.</p>
        </div>
        <span class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-ink-950">Tire sua ideia do papel →</span>
      </a>
    </div>
  </section>

  <PresencaIA />

  <!-- Segmentos -->
  <section id="segmentos" class="secao-clara border-t py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Para quem</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Soluções para <span class="text-gradient">cada tipo de negócio</span></h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {segmentos.map((s) => (
          <article class={`card card-vivo p-6 ${s.destaque ? 'escuro !border-violet-400/70 !from-[#2a1d5c] !to-ink-900 shadow-[0_30px_70px_-30px_rgb(124_58_237/0.7)]' : ''}`}>
            {s.destaque && <p class="mb-3 text-xs font-semibold text-violet-300">Experiência no setor</p>}
            <h3 class="text-lg font-semibold">{s.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.texto}</p>
            {s.link && (
              <a href={s.link.href} class="mt-4 inline-block text-sm font-semibold text-white hover:text-violet-300">
                {s.link.rotulo} <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
