<script>
  // Filtro do portfólio por tipo de negócio. Sem JS, os botões ficam escondidos e tudo aparece.
  const filtros = document.getElementById('filtros');
  if (filtros) {
    filtros.classList.remove('hidden');
    filtros.classList.add('flex');
    const botoes = filtros.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    const cards = document.querySelectorAll<HTMLElement>('#portfolio [data-categoria]');
    botoes.forEach((botao) =>
      botao.addEventListener('click', () => {
        const filtro = botao.dataset.filtro;
        botoes.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));
        cards.forEach((card) => {
          card.hidden = filtro !== 'todos' && card.dataset.categoria !== filtro;
        });
      }),
    );
  }
</script>
