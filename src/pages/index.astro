---
import Base from '../layouts/Base.astro';
import Orcamento from '../components/Orcamento.astro';
import { site } from '../data/site';
import { projetos, rotuloTipo } from '../data/projetos';

const servicos = [
  {
    titulo: 'Sites institucionais',
    texto: 'Um site profissional que apresenta o seu negócio, funciona bem no celular e ajuda clientes a encontrarem você no Google.',
    itens: ['Visual alinhado à sua marca', 'Botão de WhatsApp e formulário', 'Configuração de domínio e hospedagem'],
    icone: 'M3 5h18v12H3zM8 21h8M12 17v4',
  },
  {
    titulo: 'Landing pages',
    texto: 'Páginas focadas em um objetivo: divulgar um lançamento, apresentar um serviço ou receber contatos de anúncios.',
    itens: ['Ideal para campanhas pagas', 'Captação de contatos', 'Carregamento rápido'],
    icone: 'M4 4h16v16H4zM4 9h16M9 9v11',
  },
  {
    titulo: 'Sistemas web',
    texto: 'Ferramentas sob medida para organizar a rotina: pedidos, agendamentos, clientes, estoque ou finanças.',
    itens: ['Painéis administrativos', 'Cadastro e controle de clientes', 'Acesso pelo navegador'],
    icone: 'M4 6h16M4 12h10M4 18h7M17 15l3 3-3 3',
  },
  {
    titulo: 'Aplicativos',
    texto: 'Aplicações para celular e computador, no formato que fizer mais sentido para o seu caso e o seu orçamento.',
    itens: ['Web responsivo ou PWA', 'Aplicativo mobile quando necessário', 'Integração com sistemas'],
    icone: 'M7 2h10v20H7zM11 18h2',
  },
  {
    titulo: 'Manutenção e suporte',
    texto: 'Depois da entrega, cuidamos do seu site ou sistema para ele continuar no ar, atualizado e seguro.',
    itens: ['Pequenas alterações', 'Correções e atualizações', 'Acompanhamento da hospedagem'],
    icone: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z',
  },
];

const segmentos = [
  {
    titulo: 'Corretores e imobiliárias',
    texto: 'Sites com vitrine de imóveis, landing pages de lançamentos, captação de interessados e atendimento pelo WhatsApp.',
    destaque: true,
  },
  {
    titulo: 'Restaurantes e delivery',
    texto: 'Cardápio digital, site do restaurante e sistemas de pedidos para organizar o atendimento.',
  },
  {
    titulo: 'Comércio e serviços',
    texto: 'Sites, agendamento online e sistemas simples para controlar clientes e a rotina do negócio.',
  },
];

const etapas = [
  { titulo: 'Entendimento', texto: 'Conversamos sobre o seu negócio, o objetivo do projeto e o que já existe.' },
  { titulo: 'Planejamento', texto: 'Você recebe uma proposta com escopo, prazo, valor e o que está incluído.' },
  { titulo: 'Desenvolvimento', texto: 'Construímos o projeto e mostramos o andamento para você acompanhar.' },
  { titulo: 'Testes', texto: 'Revisamos no celular e no computador e ajustamos o que for preciso.' },
  { titulo: 'Entrega e suporte', texto: 'Publicamos, explicamos como usar e oferecemos manutenção se quiser.' },
];

const duvidas = [
  {
    p: 'Quanto custa um site ou sistema?',
    r: 'Depende do tamanho do projeto, das funcionalidades e das integrações. Depois de entender a sua necessidade, enviamos uma proposta com valor fechado e tudo o que está incluído.',
  },
  {
    p: 'Preciso já ter domínio e hospedagem?',
    r: 'Não. Ajudamos a registrar o domínio e configurar a hospedagem. Os custos desses serviços e quem fica responsável por eles ficam descritos na proposta.',
  },
  {
    p: 'Vocês atendem só o mercado imobiliário?',
    r: 'Não. Temos experiência com o setor imobiliário, mas desenvolvemos projetos para empresas e profissionais de diferentes áreas.',
  },
  {
    p: 'Consigo alterar o site depois da entrega?',
    r: 'Sim. Você pode contratar um plano de manutenção para alterações e atualizações, ou combinar ajustes pontuais quando precisar.',
  },
  {
    p: 'Como começa um projeto?',
    r: 'Basta preencher o pedido de orçamento ou chamar no WhatsApp. Marcamos uma conversa rápida para entender o que você precisa, sem compromisso.',
  },
];

const visiveis = projetos.filter((p) => p.publicar);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: site.nome,
    url: site.url,
    description: site.descricao,
    areaServed: 'BR',
    address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
    sameAs: [site.instagram, site.tiktok],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: duvidas.map((d) => ({
      '@type': 'Question',
      name: d.p,
      acceptedAnswer: { '@type': 'Answer', text: d.r },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[820px] -translate-x-1/2 rounded-full bg-violet-600/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-20 left-[15%] h-[300px] w-[420px] rounded-full bg-blue-600/15 blur-3xl" aria-hidden="true"></div>

    <div class="container-site relative py-20 sm:py-28">
      <p class="eyebrow">Desenvolvimento de software · {site.cidade}</p>
      <h1 class="mt-5 max-w-3xl text-4xl font-bold leading-[1.08] sm:text-6xl">
        Transformamos ideias em <span class="text-gradient">soluções digitais</span> para o seu negócio.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
        A INV Devs desenvolve sites, landing pages, sistemas e aplicativos sob medida para empresas e profissionais
        que querem uma presença digital profissional e processos mais organizados.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#orcamento" class="btn-primary !px-6 !py-3.5 text-base">Solicite seu orçamento</a>
        <a href="#portfolio" class="btn-ghost !px-6 !py-3.5 text-base">Conheça nossos projetos</a>
      </div>

      <ul class="mt-14 flex flex-wrap gap-x-8 gap-y-3 text-sm text-slate-400">
        {['Projetos sob medida', 'Feito para celular e computador', 'Proposta clara, sem surpresas', 'Suporte após a entrega'].map((t) => (
          <li class="flex items-center gap-2">
            <svg viewBox="0 0 20 20" class="h-4 w-4 text-violet-400" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" /></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Serviços -->
  <section id="servicos" class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Serviços</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">O que a INV Devs pode fazer pelo seu negócio</h2>
      <p class="mt-4 max-w-2xl text-slate-400">Da primeira página na internet a um sistema completo para a sua operação.</p>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {servicos.map((s) => (
          <article class="card group p-6 transition hover:border-violet-500/50">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-ink-800 text-violet-300">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icone} /></svg>
            </div>
            <h3 class="mt-5 text-lg font-semibold">{s.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.texto}</p>
            <ul class="mt-4 space-y-1.5 text-sm text-slate-300">
              {s.itens.map((i) => <li class="flex gap-2"><span class="text-violet-400" aria-hidden="true">›</span>{i}</li>)}
            </ul>
          </article>
        ))}
        <a href="#orcamento" class="card flex flex-col justify-between bg-gradient-to-br from-blue-600/15 to-violet-600/20 p-6 transition hover:border-violet-400/60">
          <div>
            <h3 class="text-lg font-semibold">Tem outra ideia?</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">Conte o que você precisa. Se for possível resolver com software, a gente conversa.</p>
          </div>
          <span class="mt-6 text-sm font-semibold text-white">Tire sua ideia do papel →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Segmentos -->
  <section class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Para quem</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Soluções para diferentes tipos de negócio</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {segmentos.map((s) => (
          <article class={`card p-6 ${s.destaque ? 'border-violet-500/40 bg-gradient-to-b from-violet-600/10 to-transparent' : ''}`}>
            {s.destaque && <p class="mb-3 text-xs font-semibold text-violet-300">Experiência no setor</p>}
            <h3 class="text-lg font-semibold">{s.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Portfólio -->
  <section id="portfolio" class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Portfólio</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Projetos desenvolvidos</h2>
      <p class="mt-4 max-w-2xl text-slate-400">Alguns trabalhos que mostram o que conseguimos construir.</p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {visiveis.map((p) => {
          const rotulo = rotuloTipo[p.tipo];
          return (
            <article class="card flex flex-col overflow-hidden">
              <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-ink-800">
                {p.imagem ? (
                  <img src={p.imagem} alt={`Tela do projeto ${p.nome}`} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
                ) : (
                  <div class="flex h-full items-center justify-center bg-gradient-to-br from-blue-600/20 via-ink-800 to-violet-600/25">
                    <span class="font-display text-2xl font-semibold text-white/80">{p.nome}</span>
                  </div>
                )}
                {rotulo && (
                  <span class="absolute bottom-3 left-3 rounded-full border border-white/10 bg-ink-950/80 px-3 py-1 text-xs text-slate-200 backdrop-blur">{rotulo}</span>
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs font-medium text-violet-300">{p.segmento}</p>
                <h3 class="mt-1 text-xl font-semibold">{p.nome}</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-400">{p.descricao}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.destaques.map((d) => <li class="rounded-lg bg-ink-800 px-2.5 py-1 text-xs text-slate-300">{d}</li>)}
                </ul>
                <div class="mt-auto flex items-center justify-between gap-4 pt-6">
                  <p class="text-xs text-slate-500">{p.stack.join(' · ')}</p>
                  {p.demo && (
                    <a href={p.url} target="_blank" rel="noopener" class="shrink-0 text-sm font-semibold text-white hover:text-violet-300">
                      Ver projeto <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Como trabalhamos -->
  <section id="como-trabalhamos" class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Como trabalhamos</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Um processo simples, do primeiro contato à entrega</h2>
      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {etapas.map((e, i) => (
          <li class="card p-6">
            <span class="font-display text-sm font-semibold text-gradient">0{i + 1}</span>
            <h3 class="mt-3 text-base font-semibold">{e.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{e.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Orçamento -->
  <section id="orcamento" class="relative overflow-hidden border-t border-line/60 py-20 sm:py-24">
    <div class="pointer-events-none absolute bottom-0 left-1/2 h-[400px] w-[700px] -translate-x-1/2 translate-y-1/2 rounded-full bg-violet-600/15 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="eyebrow">Orçamento</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Vamos desenvolver seu projeto?</h2>
        <p class="mt-4 text-slate-400">
          Conte um pouco sobre o que você precisa. Respondemos com as próximas etapas e, se fizer sentido,
          marcamos uma conversa para entender os detalhes. Sem compromisso.
        </p>
        <ul class="mt-8 space-y-4 text-sm text-slate-300">
          <li class="flex gap-3"><span class="text-violet-400" aria-hidden="true">01</span>Você envia o pedido</li>
          <li class="flex gap-3"><span class="text-violet-400" aria-hidden="true">02</span>Conversamos sobre o projeto</li>
          <li class="flex gap-3"><span class="text-violet-400" aria-hidden="true">03</span>Você recebe uma proposta com escopo, prazo e valor</li>
        </ul>
      </div>
      <Orcamento />
    </div>
  </section>

  <!-- Dúvidas -->
  <section id="duvidas" class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site max-w-3xl">
      <p class="eyebrow">Dúvidas frequentes</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Perguntas comuns</h2>
      <div class="mt-10 divide-y divide-line border-y border-line">
        {duvidas.map((d) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
              {d.p}
              <span class="text-violet-300 transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{d.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
