            <ellipse cx="50" cy="25" rx={6 + i * 5} ry={3 + i * 2.6} fill="none" stroke={i % 2 ? '#a78bfa' : '#60a5fa'} stroke-opacity={0.5 - i * 0.045} stroke-width=".25" />
