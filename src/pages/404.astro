---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada" indexar={false}>
  <section class="container-site flex min-h-[60vh] flex-col items-start justify-center py-20">
    <p class="eyebrow">Erro 404</p>
    <h1 class="mt-3 text-4xl font-bold">Página não encontrada</h1>
    <p class="mt-4 max-w-md text-slate-400">O endereço que você acessou não existe ou foi alterado.</p>
    <a href="/" class="btn-primary mt-8">Voltar para o início</a>
  </section>
</Base>
