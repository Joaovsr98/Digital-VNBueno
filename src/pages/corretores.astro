---
// Oferta para corretores: o modelo do Bueno Imóveis como serviço (implantação + mensalidade).
// Valores definidos pelo fundador em 05/11/2026 — ver CLAUDE.md §8. Mudou? Atualizar `oferta` abaixo.
import Base from '../layouts/Base.astro';
import { linkWhatsApp } from '../data/site';

const oferta = {
  implantacao: 'R$ 400',
  imoveisInclusos: 3,
  mensalidade: 'R$ 150',
  extraAntes: 'R$ 50',
  extraDepois: 'R$ 70',
};

const mensagem = 'Olá! Vi a página para corretores da INV Devs e quero o meu site de corretor.';
const exemplo = 'https://corretorbr.vercel.app';

const recursos = [
  { titulo: 'Vitrine dos seus imóveis', texto: 'Uma página para cada imóvel, com galeria de fotos, metragem, valores e localização.' },
  { titulo: 'Contato direto no WhatsApp', texto: 'O interessado fala com você a partir do imóvel que viu, com a mensagem já preenchida.' },
  { titulo: 'Feito para o celular', texto: 'A maioria dos compradores procura imóvel pelo celular. O site foi pensado primeiro para essa tela.' },
  { titulo: 'Preparado para o Google', texto: 'O conteúdo é lido pelo Google, o que ajuda quem pesquisa por imóveis na sua região a encontrar você.' },
  { titulo: 'Páginas por bairro e guias', texto: 'Espaço para apresentar as regiões em que você atua e orientar quem está comprando.' },
  { titulo: 'Sua marca, seus dados', texto: 'Seu nome, sua logo, suas cores e seus contatos. Política de privacidade e aviso de cookies (LGPD) inclusos.' },
];

// Mesmo sistema (repo consultorimobiliario, um "tenant" por corretor), marcas diferentes.
// Situação real de cada um: ver CLAUDE.md §5. Não chamar de cliente quem não fechou.
const exemplos = [
  {
    nome: 'Bueno Imóveis',
    estilo: 'Azul-marinho e dourado · lançamentos e Minha Casa Minha Vida',
    imagem: '/portfolio/bueno-imoveis.webp',
    url: 'https://corretorbr.vercel.app',
    rotulo: 'Projeto acadêmico',
  },
  {
    nome: 'Britto',
    estilo: 'Alto padrão · fonte serifada, azul e grafite',
    imagem: '/portfolio/britto.webp',
    url: 'https://consultoriabritto.vercel.app',
    rotulo: 'Projeto em andamento', // corretor amigo, ainda sem fechamento (05/11/2026)
  },
  {
    nome: 'Shelby House',
    estilo: 'Claro e acolhedor · bege e dourado, zona oeste',
    imagem: '/portfolio/shelby-house.webp',
    url: 'https://corretor-shelby.vercel.app',
    rotulo: 'Projeto acadêmico',
  },
];

const passos = [
  { titulo: 'Conversa rápida', texto: 'Você conta como trabalha, em que região atua e quais imóveis quer mostrar.' },
  { titulo: 'Envio do material', texto: 'Você manda logo, fotos e informações dos imóveis. Se não tiver logo, a gente conversa.' },
  { titulo: 'Site no ar', texto: 'Montamos, você revisa e aprova, e o site vai para o ar com os seus contatos.' },
];

const duvidas = [
  {
    p: 'O que está incluído na implantação?',
    r: `A montagem do site com a sua marca e os seus contatos, com até ${oferta.imoveisInclusos} imóveis cadastrados.`,
  },
  {
    p: 'E se eu tiver mais imóveis?',
    r: `Cada imóvel a mais custa ${oferta.extraAntes} se for incluído durante a montagem, antes da entrega. Depois que o site estiver pronto, cada novo imóvel custa ${oferta.extraDepois}.`,
  },
  {
    p: 'O que a mensalidade cobre?',
    r: 'Manter o seu site no ar (hospedagem) e o suporte pelo WhatsApp. O detalhe do que está incluído fica no contrato.',
  },
  {
    p: 'Preciso ter domínio próprio (.com.br)?',
    r: 'Não é obrigatório para começar. Se quiser um endereço próprio, ajudamos a registrar; o domínio é pago à parte, direto no registro.br.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: duvidas.map((d) => ({ '@type': 'Question', name: d.p, acceptedAnswer: { '@type': 'Answer', text: d.r } })),
  },
];
---

<Base
  titulo="Site para corretor de imóveis"
  descricao={`Site para corretor de imóveis com seus imóveis, sua marca e contatos direto no WhatsApp. Implantação ${oferta.implantacao} e mensalidade ${oferta.mensalidade}.`}
  jsonLd={jsonLd}
>
  <!-- Topo -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[820px] -translate-x-1/2 rounded-full bg-violet-600/20 blur-3xl" aria-hidden="true"></div>

    <div class="container-site relative grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="eyebrow">Para corretores de imóveis</p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.08] sm:text-5xl">
          Seu site de corretor, com <span class="text-gradient">seus imóveis</span> e contatos direto no WhatsApp.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
          Um site profissional com a sua marca, para apresentar seus imóveis e receber interessados sem depender só das redes sociais.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary !px-6 !py-3.5 text-base">Quero o meu site</a>
          <a href={exemplo} target="_blank" rel="noopener" class="btn-ghost !px-6 !py-3.5 text-base">
            Ver um exemplo <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-400">
          Implantação <strong class="text-white">{oferta.implantacao}</strong> · mensalidade <strong class="text-white">{oferta.mensalidade}</strong>
        </p>
      </div>

      <!-- Exemplo no celular -->
      <div class="mx-auto w-full max-w-[300px]">
        <div class="rounded-[2.2rem] border border-line bg-ink-900 p-2.5 shadow-2xl shadow-violet-900/30">
          <img
            src="/portfolio/bueno-imoveis-celular.webp"
            alt="Exemplo de site de corretor aberto no celular"
            width="390"
            height="844"
            class="w-full rounded-[1.7rem]"
          />
        </div>
        <p class="mt-3 text-center text-xs text-slate-500">Exemplo: Bueno Imóveis (projeto acadêmico)</p>
      </div>
    </div>
  </section>

  <!-- O que o site tem -->
  <section class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">O que o site tem</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Tudo o que o comprador procura, no seu nome</h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {recursos.map((r) => (
          <article class="card p-6">
            <h3 class="text-lg font-semibold">{r.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{r.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Exemplos: mesmo sistema, marcas diferentes -->
  <section id="exemplos" class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Exemplos</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Mesmo sistema, a cara de cada corretor</h2>
      <p class="mt-4 max-w-2xl text-slate-400">Cores, fontes, logo e imóveis mudam para combinar com o seu jeito de trabalhar. Veja três sites feitos com a mesma base:</p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {exemplos.map((e) => (
          <article class="card flex flex-col overflow-hidden">
            <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-ink-800">
              <img src={e.imagem} alt={`Site ${e.nome}`} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
              <span class="absolute bottom-3 left-3 rounded-full border border-white/10 bg-ink-950/80 px-3 py-1 text-xs text-slate-200 backdrop-blur">{e.rotulo}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-lg font-semibold">{e.nome}</h3>
              <p class="mt-1 text-sm text-slate-400">{e.estilo}</p>
              <a href={e.url} target="_blank" rel="noopener" class="mt-auto pt-5 text-sm font-semibold text-white hover:text-violet-300">
                Ver o site <span aria-hidden="true">↗</span><span class="sr-only">(abre em nova aba)</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Preço -->
  <section id="preco" class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Investimento</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Quanto custa</h2>

      <div class="mt-12 grid gap-5 lg:grid-cols-[1.3fr_1fr]">
        <article class="card border-violet-500/50 bg-gradient-to-b from-violet-600/10 to-transparent p-6 sm:p-8">
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <p class="text-sm text-slate-400">Implantação</p>
              <p class="mt-1 font-display text-4xl font-bold text-white">{oferta.implantacao}</p>
              <p class="mt-2 text-sm text-slate-300">pagamento único · inclui até {oferta.imoveisInclusos} imóveis</p>
            </div>
            <div>
              <p class="text-sm text-slate-400">Mensalidade</p>
              <p class="mt-1 font-display text-4xl font-bold text-white">{oferta.mensalidade}<span class="text-lg font-semibold text-slate-400">/mês</span></p>
              <p class="mt-2 text-sm text-slate-300">site no ar e suporte pelo WhatsApp</p>
            </div>
          </div>
          <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary mt-8 w-full sm:w-auto">Quero o meu site</a>
        </article>

        <article class="card p-6 sm:p-8">
          <h3 class="text-lg font-semibold">Imóveis a mais</h3>
          <p class="mt-2 text-sm text-slate-400">Além dos {oferta.imoveisInclusos} imóveis da implantação:</p>
          <dl class="mt-6 space-y-4">
            <div class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
              <dt class="text-sm text-slate-300">Incluído durante a montagem, antes da entrega</dt>
              <dd class="shrink-0 font-display text-2xl font-bold text-white">{oferta.extraAntes}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm text-slate-300">Incluído depois que o site estiver pronto</dt>
              <dd class="shrink-0 font-display text-2xl font-bold text-white">{oferta.extraDepois}</dd>
            </div>
          </dl>
          <p class="mt-6 text-xs text-slate-500">Valores por imóvel. Domínio próprio (.com.br), se quiser, é pago à parte.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site">
      <p class="eyebrow">Como funciona</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Três passos até o seu site no ar</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {passos.map((p, i) => (
          <li class="card p-6">
            <span class="font-display text-sm font-semibold text-gradient">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-semibold">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Dúvidas -->
  <section class="border-t border-line/60 py-20 sm:py-24">
    <div class="container-site max-w-3xl">
      <p class="eyebrow">Dúvidas</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Perguntas comuns</h2>
      <div class="mt-10 divide-y divide-line border-y border-line">
        {duvidas.map((d) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
              {d.p}
              <span class="text-violet-300 transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{d.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Chamada final -->
  <section class="border-t border-line/60 bg-ink-900/40 py-20 sm:py-24">
    <div class="container-site text-center">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold sm:text-4xl">Vamos colocar seus imóveis na internet?</h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-400">Chame no WhatsApp e conte como você trabalha. A conversa é sem compromisso.</p>
      <a href={linkWhatsApp(mensagem)} target="_blank" rel="noopener" class="btn-primary mt-8 !px-8 !py-4 text-base">Fale com a INV Devs</a>
    </div>
  </section>
</Base>
