---
// Seção "Presença no Google e nas IAs" (14/11/2026). Diagrama de órbitas só em CSS (sem JS):
// o negócio do cliente no centro, buscadores e IAs girando nas três camadas do trabalho.
// Nomes das plataformas em texto (sem logos de marca). Promessa: trabalho e medição mensal,
// nunca "garantimos aparecer". Com "reduzir movimento", as órbitas ficam paradas.
// Sem atributo style no HTML (a CSP bloqueia): ângulo e velocidade vêm de classes do bloco de estilo.
import { linkWhatsApp } from '../data/site';

const camadas = [
  {
    titulo: 'Base técnica',
    texto: 'Site rápido, dados estruturados e o arquivo llms.txt, que ajudam o Google e as IAs a entender quem você é, o que faz e onde atende.',
  },
  {
    titulo: 'Perfil no Google',
    texto: 'Perfil da Empresa configurado, com categoria, endereço, horários e fotos certos, para aparecer no mapa e nas buscas da região.',
  },
  {
    titulo: 'Conteúdo e medição',
    texto: 'Respostas para as perguntas que o seu cliente faz e, todo mês, um relatório mostrando em quais IAs o seu negócio apareceu.',
  },
];

// Plataformas em cada órbita (de dentro para fora).
const orbitas = [
  { raio: 'inset-[22%]', vel: 'v1', itens: [{ nome: 'Google', ang: 'a210' }, { nome: 'Google Maps', ang: 'a30' }] },
  { raio: 'inset-[11%]', vel: 'v2', itens: [{ nome: 'ChatGPT', ang: 'a300' }, { nome: 'Gemini', ang: 'a130' }] },
  { raio: 'inset-0', vel: 'v3', itens: [{ nome: 'Perplexity', ang: 'a250' }, { nome: 'Copilot', ang: 'a70' }] },
];
---

<section id="presenca" class="relative overflow-hidden border-t border-line/60 bg-ink-950 py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(45%_60%_at_78%_50%,rgb(59_130_246/0.16),transparent_70%)]" aria-hidden="true"></div>
  <div class="container-site relative grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <p class="eyebrow">Presença no Google e nas IAs</p>
      <h2 class="mt-4 text-3xl font-bold leading-tight sm:text-[2.6rem]">
        Quando o seu cliente pergunta ao Google ou a uma IA, <span class="text-gradient">o seu negócio aparece?</span>
      </h2>
      <p class="mt-5 max-w-xl leading-relaxed text-slate-300">
        Cada vez mais gente pergunta ao ChatGPT ou ao Google qual é a melhor oficina, clínica ou corretor da região. Trabalhamos a sua presença em três camadas e, todo mês, medimos se o seu negócio aparece nessas respostas.
      </p>

      <ol class="mt-8 space-y-3">
        {camadas.map((c, i) => (
          <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-violet-500 font-display text-sm font-semibold text-white">{i + 1}</span>
            <div>
              <h3 class="text-base font-semibold">{c.titulo}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-400">{c.texto}</p>
            </div>
          </li>
        ))}
      </ol>

      <a href={linkWhatsApp('Olá! Quero saber se o meu negócio aparece no Google e nas IAs.')} target="_blank" rel="noopener" class="btn-primary mt-8 !px-6 !py-3.5">Quero o meu negócio nas IAs</a>
      <p class="mt-4 max-w-xl text-xs leading-relaxed text-slate-500">
        Nenhuma empresa consegue garantir que uma IA vai citar o seu negócio, porque a resposta muda conforme a pessoa, a cidade e o dia. O que entregamos é o trabalho feito e a medição todo mês.
      </p>
    </div>

    <!-- Diagrama de órbitas -->
    <div class="relative mx-auto aspect-square w-full max-w-[520px]" aria-hidden="true">
      {orbitas.map((o) => (
        <div class={`orbita ${o.vel} absolute ${o.raio} rounded-full border border-white/10`}>
          {o.itens.map((it) => (
            <div class={`braco ${it.ang} absolute inset-0`}>
              <span class="planeta absolute left-1/2 top-0">
                <span class="block whitespace-nowrap rounded-full border border-white/15 bg-ink-900/90 px-3 py-1.5 text-xs font-medium text-slate-200 shadow-lg shadow-black/40">{it.nome}</span>
              </span>
            </div>
          ))}
        </div>
      ))}
      <div class="absolute inset-[37%] flex items-center justify-center rounded-full bg-gradient-to-br from-blue-500 via-indigo-500 to-violet-600 text-center shadow-[0_0_80px_-10px_rgb(124_58_237/0.8)]">
        <span class="px-2 font-display text-sm font-bold uppercase leading-tight tracking-wide text-white sm:text-base">Seu<br />negócio</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* A órbita gira; cada nome gira ao contrário, para continuar de pé. */
  .v1 { --duracao: 38s; }
  .v2 { --duracao: 54s; }
  .v3 { --duracao: 72s; }
  .a30 { --ang: 30deg; }
  .a70 { --ang: 70deg; }
  .a130 { --ang: 130deg; }
  .a210 { --ang: 210deg; }
  .a250 { --ang: 250deg; }
  .a300 { --ang: 300deg; }
  .braco { transform: rotate(var(--ang)); }
  .orbita { animation: girar var(--duracao) linear infinite; }
  .planeta {
    transform: translate(-50%, -50%) rotate(calc(var(--ang) * -1));
    animation: desgirar var(--duracao) linear infinite;
  }
  @keyframes girar { to { transform: rotate(360deg); } }
  @keyframes desgirar {
    from { transform: translate(-50%, -50%) rotate(calc(var(--ang) * -1)); }
    to { transform: translate(-50%, -50%) rotate(calc(var(--ang) * -1 - 360deg)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbita, .planeta { animation: none; }
  }
</style>
