---
import { site } from '../data/site';

const servicos = [
  'Site institucional',
  'Landing page',
  'Sistema web',
  'Aplicativo',
  'Manutenção de site ou sistema',
  'Ainda não sei',
];

const campo =
  'mt-2 w-full rounded-xl border border-line bg-ink-950 px-4 py-3 text-sm text-white placeholder:text-slate-400 focus:border-violet-400 focus:outline-none';
---

<form id="form-orcamento" class="card p-6 sm:p-8" novalidate data-whatsapp={site.whatsapp}>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-medium text-slate-200">
      Nome *
      <input name="nome" required autocomplete="name" class={campo} placeholder="Seu nome" />
    </label>
    <label class="block text-sm font-medium text-slate-200">
      Empresa
      <input name="empresa" autocomplete="organization" class={campo} placeholder="Nome do negócio (opcional)" />
    </label>

    <label class="block text-sm font-medium text-slate-200">
      Tipo de serviço *
      <select name="servico" required class={campo}>
        <option value="" disabled selected>Selecione</option>
        {servicos.map((s) => <option>{s}</option>)}
      </select>
    </label>
    <label class="block text-sm font-medium text-slate-200">
      Telefone ou e-mail *
      <input name="contato" required autocomplete="tel" class={campo} placeholder="(11) 90000-0000" />
    </label>

    <label class="block text-sm font-medium text-slate-200 sm:col-span-2">
      Conte sobre o projeto *
      <textarea
        name="descricao"
        required
        rows="5"
        class={campo}
        placeholder="O que você precisa, para quem é e se já tem algum material (logo, textos, fotos, site atual)."
      ></textarea>
    </label>

    <fieldset class="sm:col-span-2">
      <legend class="text-sm font-medium text-slate-200">Como prefere conversar?</legend>
      <div class="mt-3 flex flex-wrap gap-3">
        {['WhatsApp', 'Ligação', 'E-mail'].map((opcao, i) => (
          <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-line px-4 py-2.5 text-sm text-slate-300 has-[:checked]:border-violet-400 has-[:checked]:text-white">
            <input type="radio" name="preferencia" value={opcao} checked={i === 0} class="accent-violet-500" />
            {opcao}
          </label>
        ))}
      </div>
    </fieldset>

    <label class="flex items-start gap-3 text-sm text-slate-400 sm:col-span-2">
      <input type="checkbox" name="consentimento" required class="mt-1 accent-violet-500" />
      <span>
        Concordo que a INV Devs use estes dados apenas para responder ao meu pedido de orçamento, conforme a
        <a href="/privacidade" class="text-violet-300 underline underline-offset-2 hover:text-white">política de privacidade</a>. *
      </span>
    </label>
  </div>

  <p id="form-erro" class="mt-5 hidden text-sm text-rose-300" role="alert"></p>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-xs text-slate-400">Ao enviar, abrimos o WhatsApp com a sua mensagem pronta.</p>
    <button type="submit" class="btn-primary">Enviar pedido de orçamento</button>
  </div>

  <noscript>
    <p class="mt-4 text-sm text-amber-300">
      Para enviar pelo formulário, ative o JavaScript. Você também pode falar com a gente pelo Instagram
      <a href={site.instagram} class="underline">@inv.devs</a>.
    </p>
  </noscript>
</form>

<script>
  const form = document.getElementById('form-orcamento') as HTMLFormElement | null;
  const erro = document.getElementById('form-erro');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!erro) return;

    const dados = new FormData(form);
    const valor = (k: string) => String(dados.get(k) ?? '').trim();

    const faltando: string[] = [];
    if (!valor('nome')) faltando.push('nome');
    if (!valor('servico')) faltando.push('tipo de serviço');
    if (!valor('contato')) faltando.push('telefone ou e-mail');
    if (!valor('descricao')) faltando.push('descrição do projeto');

    if (faltando.length) {
      erro.textContent = `Preencha: ${faltando.join(', ')}.`;
      erro.classList.remove('hidden');
      return;
    }
    if (!dados.get('consentimento')) {
      erro.textContent = 'Para enviar, marque a concordância com a política de privacidade.';
      erro.classList.remove('hidden');
      return;
    }

    const numero = form.dataset.whatsapp;
    if (!numero) {
      erro.textContent = 'O envio ainda não está disponível. Fale com a gente pelo Instagram @inv.devs.';
      erro.classList.remove('hidden');
      return;
    }
    erro.classList.add('hidden');

    const linhas = [
      'Olá, INV Devs! Gostaria de um orçamento.',
      '',
      `*Nome:* ${valor('nome')}`,
      valor('empresa') ? `*Empresa:* ${valor('empresa')}` : null,
      `*Serviço:* ${valor('servico')}`,
      `*Contato:* ${valor('contato')}`,
      `*Prefiro conversar por:* ${valor('preferencia')}`,
      '',
      `*Sobre o projeto:*`,
      valor('descricao'),
    ].filter((l) => l !== null);

    window.open(`https://wa.me/${numero}?text=${encodeURIComponent(linhas.join('\n'))}`, '_blank', 'noopener');
  });
</script>
