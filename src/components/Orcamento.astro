---
import { site } from '../data/site';

// Escolha em botões (mais rápido que lista suspensa, principalmente no celular).
const servicos = [
  { valor: 'Site institucional', icone: 'M3 5h18v12H3zM8 21h8M12 17v4' },
  { valor: 'Landing page', icone: 'M4 4h16v16H4zM4 9h16M9 9v11' },
  { valor: 'Sistema web', icone: 'M4 6h16M4 12h10M4 18h7M17 15l3 3-3 3' },
  { valor: 'Aplicativo', icone: 'M7 2h10v20H7zM11 18h2' },
  { valor: 'Manutenção ou ajuste', icone: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z' },
  { valor: 'Ainda não sei', icone: 'M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z' },
];

const campo =
  'mt-2 w-full rounded-xl border border-[#d3dfec] bg-[#f4f8fc] px-4 py-3 text-base text-[#0b1226] placeholder:text-slate-400 transition focus:border-violet-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-violet-500/15 sm:text-sm';
const passo = 'flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-violet-500 font-display text-xs font-semibold text-white shadow-md shadow-violet-500/30';
---

<!-- Formulário claro (14/11/2026): card branco com faixa em degradê; opções acendem em degradê ao escolher.
     A classe "proprio" tira o formulário das trocas automáticas de cor da .secao-clara. -->
<form id="form-orcamento" class="proprio relative overflow-hidden rounded-3xl bg-white p-6 shadow-[0_30px_80px_-30px_rgb(30_41_82/0.35)] ring-1 ring-[#d3dfec] sm:p-8" novalidate data-whatsapp={site.whatsapp}>
  <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-cyan-400 via-blue-500 to-violet-500" aria-hidden="true"></div>
  <fieldset>
    <legend class="flex items-center gap-2.5 text-base font-semibold text-[#0b1226]"><span class={passo}>1</span> O que você precisa?</legend>
    <div class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
      {servicos.map((s) => (
        <label class="group flex cursor-pointer items-center gap-2.5 rounded-xl border border-[#d3dfec] bg-[#f4f8fc] px-3 py-3 text-sm font-medium text-[#334155] transition hover:-translate-y-0.5 hover:border-violet-300 hover:bg-white hover:shadow-md has-[:checked]:border-transparent has-[:checked]:bg-gradient-to-br has-[:checked]:from-blue-500 has-[:checked]:to-violet-500 has-[:checked]:text-white has-[:checked]:shadow-lg has-[:checked]:shadow-violet-500/30 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-violet-500">
          <input type="radio" name="servico" value={s.valor} class="sr-only" />
          <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-violet-500 group-has-[:checked]:text-white" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icone} /></svg>
          <span class="leading-tight">{s.valor}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="mt-7">
    <p class="flex items-center gap-2.5 text-base font-semibold text-[#0b1226]"><span class={passo}>2</span> Quem é você?</p>
    <div class="mt-2 grid gap-3 sm:grid-cols-2">
      <label class="block text-sm font-medium text-[#334155]">
        Seu nome *
        <input name="nome" required autocomplete="name" class={campo} placeholder="Como podemos te chamar?" />
      </label>
      <label class="block text-sm font-medium text-[#334155]">
        Seu negócio <span class="font-normal text-slate-500">(opcional)</span>
        <input name="empresa" autocomplete="organization" class={campo} placeholder="Ex.: Oficina do Zé" />
      </label>
    </div>
  </div>

  <label class="mt-7 block">
    <span class="flex items-center gap-2.5 text-base font-semibold text-[#0b1226]"><span class={passo}>3</span> Conte rapidinho <span class="text-sm font-normal text-slate-500">(opcional)</span></span>
    <textarea
      name="descricao"
      rows="3"
      class={campo}
      placeholder="Ex.: quero um site para minha oficina com fotos e botão de WhatsApp. Já tenho logo."
    ></textarea>
  </label>

  <label class="mt-6 flex items-start gap-3 text-sm text-slate-600">
    <input type="checkbox" name="consentimento" required class="mt-0.5 h-4 w-4 shrink-0 accent-violet-500" />
    <span>
      Concordo que a VN Bueno Digital use estes dados apenas para responder ao meu pedido, conforme a{' '}
      <a href="/privacidade" class="font-medium text-violet-600 underline underline-offset-2 hover:text-violet-800">política de privacidade</a>.
    </span>
  </label>

  <p id="form-erro" class="mt-5 hidden rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700" role="alert"></p>

  <button type="submit" class="btn-primary mt-6 w-full !py-3.5 text-base">
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3z" /></svg>
    Enviar pelo WhatsApp
  </button>
  <p class="mt-3 text-center text-xs text-slate-500">Abre o seu WhatsApp com a mensagem pronta. Você revisa antes de enviar.</p>

  <noscript>
    <p class="mt-4 text-sm text-amber-700">
      Para enviar pelo formulário, ative o JavaScript. Você também pode falar com a gente pelo Instagram
      <a href={site.instagram} class="underline">@vnbuenodigital</a>.
    </p>
  </noscript>
</form>

<script>
  const form = document.getElementById('form-orcamento') as HTMLFormElement | null;
  const erro = document.getElementById('form-erro');
  const previa = document.getElementById('previa-mensagem');

  const montar = () => {
    if (!form) return [];
    const dados = new FormData(form);
    const valor = (k: string) => String(dados.get(k) ?? '').trim();
    return [
      'Olá, VN Bueno Digital! Gostaria de um orçamento.',
      '',
      `*Nome:* ${valor('nome') || '…'}`,
      valor('empresa') ? `*Negócio:* ${valor('empresa')}` : null,
      `*Preciso de:* ${valor('servico') || '…'}`,
      valor('descricao') ? '' : null,
      valor('descricao') ? `*Sobre o projeto:* ${valor('descricao')}` : null,
    ].filter((l): l is string => l !== null);
  };

  // Prévia ao vivo da mensagem (coluna ao lado, no computador)
  const atualizarPrevia = () => {
    if (!previa) return;
    previa.innerHTML = '';
    montar().forEach((linha) => {
      const p = document.createElement('p');
      if (!linha) { p.className = 'h-2'; previa.appendChild(p); return; }
      const m = linha.match(/^\*(.+?)\*\s?(.*)$/);
      if (m) { const b = document.createElement('strong'); b.textContent = m[1] + ' '; p.appendChild(b); p.append(m[2]); }
      else p.textContent = linha;
      previa.appendChild(p);
    });
  };
  form?.addEventListener('input', atualizarPrevia);
  form?.addEventListener('change', atualizarPrevia);
  atualizarPrevia();

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!erro) return;
    const dados = new FormData(form);
    const valor = (k: string) => String(dados.get(k) ?? '').trim();

    const faltando: string[] = [];
    if (!valor('servico')) faltando.push('o que você precisa');
    if (!valor('nome')) faltando.push('seu nome');
    if (faltando.length) {
      erro.textContent = `Falta escolher ou preencher: ${faltando.join(' e ')}.`;
      erro.classList.remove('hidden');
      return;
    }
    if (!dados.get('consentimento')) {
      erro.textContent = 'Para enviar, marque a concordância com a política de privacidade.';
      erro.classList.remove('hidden');
      return;
    }
    const numero = form.dataset.whatsapp;
    if (!numero) {
      erro.textContent = 'O envio ainda não está disponível. Fale com a gente pelo Instagram @vnbuenodigital.';
      erro.classList.remove('hidden');
      return;
    }
    erro.classList.add('hidden');
    window.open(`https://wa.me/${numero}?text=${encodeURIComponent(montar().join('\n'))}`, '_blank', 'noopener');
  });
</script>
