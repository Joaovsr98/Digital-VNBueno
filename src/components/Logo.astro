---
// Logo fornecida em LOGO VN.rev1.ai.
// O nome é texto para ficar nítido e legível por buscadores e leitores de tela.
interface Props {
  class?: string;
  mostrarNome?: boolean;
}
const { class: className = '', mostrarNome = true } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <img src="/logo-vn-bueno-72.webp" alt="" width="36" height="36" class="h-9 w-9 shrink-0 object-contain" />
  {mostrarNome && (
    <span class="whitespace-nowrap font-display text-lg font-bold tracking-tight text-white">
      VN Bueno <span class="text-gradient">Digital</span>
    </span>
  )}
</span>
